---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  PROFILE,
  SKILLS,
  EXPERIENCE,
  EDUCATION,
  CERTIFICATIONS,
  ACHIEVEMENTS,
} from '../content/profile.ts';

const description = `About Ahmed — PHP and Python developer with experience in CRM systems, workflow automation, RESTful APIs, and data integrations at StudyNet Pty Ltd.`;
---

<BaseLayout title="About" description={description}>
  <!-- ── Hero ── -->
  <section class="about-hero section-sm" aria-labelledby="about-heading">
    <div class="container about-hero-inner">
      <div>
        <p class="eyebrow">About me</p>
        <h1 id="about-heading">Building applications<br/><span class="text-accent">that actually work.</span></h1>
        <p class="hero-body">{PROFILE.summary}</p>

        <div class="about-hero-actions">
          {PROFILE.resumePath && (
            <a
              href={PROFILE.resumePath}
              class="btn btn-primary"
              target="_blank"
              rel="noopener noreferrer"
              download
            >
              Download résumé
            </a>
          )}
          <a href={`mailto:${PROFILE.email}`} class="btn btn-outline">Send email</a>
        </div>
      </div>

      <div class="about-photo-frame" aria-hidden="true">
        <img
          src={PROFILE.profileImage}
          alt=""
          width="280"
          height="280"
          loading="lazy"
          class="about-photo"
        />
      </div>
    </div>
  </section>

  <!-- ── Experience ── -->
  <section class="section" aria-labelledby="exp-heading">
    <div class="container">
      <h2 id="exp-heading" class="section-heading">Work Experience</h2>

      <ol class="timeline" reversed>
        {EXPERIENCE.map((job, i) => (
          <li class="timeline-item">
            <div class="timeline-marker" aria-hidden="true">
              <span class="timeline-dot"></span>
              {i < EXPERIENCE.length - 1 && <span class="timeline-line"></span>}
            </div>
            <div class="timeline-content card">
              <div class="timeline-header">
                <div>
                  <h3 class="timeline-title">{job.title}</h3>
                  <p class="timeline-meta">
                    <span class="timeline-company">{job.company}</span>
                    <span class="timeline-sep" aria-hidden="true">·</span>
                    <span class="timeline-location">{job.location}</span>
                  </p>
                </div>
                <time class="timeline-period badge">{job.period}</time>
              </div>
              <ul class="timeline-highlights">
                {job.highlights.map(h => <li>{h}</li>)}
              </ul>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ── Education ── -->
  <section class="section-sm" style="background: var(--color-bg-secondary);" aria-labelledby="edu-heading">
    <div class="container">
      <h2 id="edu-heading" class="section-heading">Education</h2>

      <div class="edu-grid">
        {EDUCATION.map(edu => (
          <div class="card edu-card">
            <div class="edu-header">
              <div>
                <h3 class="edu-institution">{edu.institution}</h3>
                <p class="edu-location text-secondary">{edu.location}</p>
              </div>
              <time class="badge">{edu.period}</time>
            </div>
            <p class="edu-qualification">{edu.qualification}</p>
            <p class="edu-result text-accent">{edu.result}</p>
            {edu.awards.length > 0 && (
              <ul class="edu-awards">
                {edu.awards.map(a => <li>🏆 {a}</li>)}
              </ul>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Skills ── -->
  <section class="section-sm" aria-labelledby="skills-heading">
    <div class="container">
      <h2 id="skills-heading" class="section-heading">Technical Skills</h2>
      <p class="section-sub-sm">Capabilities grouped by category. No made-up proficiency percentages.</p>

      <div class="skills-grid">
        {SKILLS.map(group => (
          <div class="skill-group card">
            <h3 class="skill-group-title">{group.category}</h3>
            <ul class="skill-tags" role="list">
              {group.items.map(item => (
                <li><span class="badge badge-accent">{item}</span></li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Certifications & Achievements ── -->
  <section class="section-sm" style="background: var(--color-bg-secondary);" aria-labelledby="certs-heading">
    <div class="container certs-grid">
      <div>
        <h2 id="certs-heading" class="section-heading">Certifications</h2>
        <ul class="list-plain">
          {CERTIFICATIONS.map(c => <li class="list-item">📜 {c}</li>)}
        </ul>
      </div>
      <div>
        <h2 class="section-heading">Awards</h2>
        <ul class="list-plain">
          {ACHIEVEMENTS.map(a => <li class="list-item">🏆 {a}</li>)}
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
/* ── Hero ── */
.about-hero {
  border-bottom: 1px solid var(--color-border);
}

.about-hero-inner {
  display: grid;
  grid-template-columns: 1fr auto;
  gap: var(--space-12);
  align-items: center;
}

.eyebrow {
  font-size: var(--text-sm);
  font-weight: var(--font-semibold);
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: var(--color-accent);
  margin-bottom: var(--space-3);
}

h1 {
  font-size: clamp(var(--text-3xl), 5vw, var(--text-4xl));
  margin-bottom: var(--space-5);
  line-height: 1.15;
}

.hero-body {
  font-size: var(--text-lg);
  line-height: var(--leading-relaxed);
  color: var(--color-text-secondary);
  max-width: 54ch;
  margin-bottom: var(--space-8);
}

.about-hero-actions {
  display: flex;
  gap: var(--space-3);
  flex-wrap: wrap;
}

.about-photo-frame {
  width: 220px;
  height: 220px;
  border-radius: var(--radius-2xl);
  overflow: hidden;
  border: 2px solid var(--color-border);
  flex-shrink: 0;
}

.about-photo {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center top;
}

/* ── Section headings ── */
.section-heading {
  font-size: clamp(var(--text-2xl), 3vw, var(--text-3xl));
  margin-bottom: var(--space-8);
}

.section-sub-sm {
  color: var(--color-text-secondary);
  margin-top: calc(-1 * var(--space-5));
  margin-bottom: var(--space-8);
}

/* ── Timeline ── */
.timeline {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
}

.timeline-item {
  display: flex;
  gap: var(--space-5);
}

.timeline-marker {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
  padding-top: var(--space-6);
}

.timeline-dot {
  width: 14px;
  height: 14px;
  border-radius: 50%;
  background: var(--color-accent);
  flex-shrink: 0;
  box-shadow: 0 0 0 4px color-mix(in srgb, var(--color-teal) 20%, transparent);
}

.timeline-line {
  width: 2px;
  flex: 1;
  background: var(--color-border);
  margin-top: var(--space-2);
  min-height: var(--space-4);
}

.timeline-content {
  flex: 1;
  margin-bottom: var(--space-4);
}

.timeline-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: var(--space-4);
  margin-bottom: var(--space-4);
  flex-wrap: wrap;
}

.timeline-title {
  font-size: var(--text-lg);
  font-weight: var(--font-semibold);
  margin-bottom: var(--space-1);
}

.timeline-meta {
  display: flex;
  gap: var(--space-2);
  align-items: center;
  font-size: var(--text-sm);
  color: var(--color-text-secondary);
}

.timeline-sep { color: var(--color-text-tertiary); }
.timeline-period { flex-shrink: 0; font-size: var(--text-xs); }

.timeline-highlights {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
  padding-left: var(--space-5);
}

.timeline-highlights li {
  font-size: var(--text-sm);
  line-height: var(--leading-relaxed);
  color: var(--color-text-secondary);
}

/* ── Education ── */
.edu-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
  gap: var(--space-6);
}

.edu-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: var(--space-4);
  margin-bottom: var(--space-3);
  flex-wrap: wrap;
}

.edu-institution {
  font-size: var(--text-lg);
  font-weight: var(--font-semibold);
}

.edu-location { font-size: var(--text-sm); }

.edu-qualification {
  font-size: var(--text-sm);
  color: var(--color-text-secondary);
  margin-bottom: var(--space-2);
}

.edu-result {
  font-weight: var(--font-semibold);
  font-size: var(--text-sm);
  margin-bottom: var(--space-3);
}

.edu-awards {
  list-style: none;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: var(--space-1);
}

.edu-awards li {
  font-size: var(--text-xs);
  color: var(--color-text-secondary);
}

/* ── Skills ── */
.skills-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
  gap: var(--space-4);
}

.skill-group-title {
  font-size: var(--text-xs);
  font-weight: var(--font-semibold);
  text-transform: uppercase;
  letter-spacing: 0.07em;
  color: var(--color-text-tertiary);
  margin-bottom: var(--space-3);
}

.skill-tags {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2);
  list-style: none;
  padding: 0;
  margin: 0;
}

/* ── Certs ── */
.certs-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-12);
}

.list-plain {
  list-style: none;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
}

.list-item {
  font-size: var(--text-sm);
  color: var(--color-text-secondary);
  line-height: var(--leading-relaxed);
}

/* ── Responsive ── */
@media (max-width: 768px) {
  .about-hero-inner {
    grid-template-columns: 1fr;
  }

  .about-photo-frame {
    width: 140px;
    height: 140px;
  }

  .certs-grid {
    grid-template-columns: 1fr;
    gap: var(--space-8);
  }

  .timeline-marker {
    display: none;
  }

  .timeline-item {
    gap: 0;
  }
}
</style>
