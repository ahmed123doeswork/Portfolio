---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  PROFILE,
  SKILLS,
  EXPERIENCE,
  EDUCATION,
  CERTIFICATIONS,
  ACHIEVEMENTS,
} from '../content/profile.ts';

const description = `About Ahmed - PHP and Python developer with experience in CRM systems, workflow automation, RESTful APIs, and data integrations at StudyNet Pty Ltd.`;
---

<BaseLayout title="About" description={description}>

  <!-- ── Hero ── -->
  <section class="about-hero section-sm" aria-labelledby="about-heading">
    <div class="container about-hero-inner">

      <div class="about-hero-text">
        <h1 id="about-heading" class="about-h1">
          Building applications<br/>that work.
        </h1>
        <p class="about-summary">{PROFILE.summary}</p>

        <div class="about-actions">
          {PROFILE.resumePath && (
            <a
              href={PROFILE.resumePath}
              class="btn btn-primary"
              target="_blank"
              rel="noopener noreferrer"
              download
            >Download résumé</a>
          )}
          <a href={`mailto:${PROFILE.email}`} class="btn btn-outline">Send email</a>
        </div>
      </div>

      <div class="about-photo-wrap" aria-hidden="true">
        <img
          src={PROFILE.profileImage}
          alt=""
          width="240"
          height="280"
          loading="lazy"
          class="about-photo"
        />
      </div>
    </div>
  </section>

  <!-- ── Experience ── -->
  <section class="section" aria-labelledby="exp-heading">
    <div class="container">
      <h2 id="exp-heading" class="page-section-title">Experience</h2>

      <div class="exp-list">
        {EXPERIENCE.map((job, i) => (
          <div class:list={['exp-item', { 'exp-item--current': i === 0 }]}>
            <div class="exp-meta">
              <time class="exp-period">{job.period}</time>
              {i === 0 && <span class="exp-current-badge">Current</span>}
            </div>
            <div class="exp-content">
              <h3 class="exp-title">{job.title}</h3>
              <p class="exp-org">{job.company} &nbsp;·&nbsp; {job.location}</p>
              <ul class="exp-highlights">
                {job.highlights.map(h => <li>{h}</li>)}
              </ul>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Skills ── -->
  <section class="section-sm skills-section" aria-labelledby="skills-heading">
    <div class="container">
      <h2 id="skills-heading" class="page-section-title">Skills</h2>
      <p class="section-note">No invented proficiency percentages - capabilities grouped by category.</p>

      <div class="skills-table" role="table" aria-label="Technical skills by category">
        {SKILLS.map(group => (
          <div class="skill-row" role="row">
            <span class="skill-label" role="rowheader">{group.category}</span>
            <span class="skill-value" role="cell">{group.items.join(' · ')}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Education ── -->
  <section class="section-sm edu-section" aria-labelledby="edu-heading">
    <div class="container">
      <h2 id="edu-heading" class="page-section-title">Education</h2>

      <div class="edu-list">
        {EDUCATION.map(edu => (
          <div class="edu-item">
            <div class="edu-meta">
              <time class="exp-period">{edu.period}</time>
            </div>
            <div class="edu-content">
              <h3 class="edu-institution">{edu.institution}</h3>
              <p class="edu-location">{edu.location}</p>
              <p class="edu-qual">{edu.qualification}</p>
              <p class="edu-result">{edu.result}</p>
              {edu.awards.length > 0 && (
                <ul class="edu-awards">
                  {edu.awards.map(a => <li>{a}</li>)}
                </ul>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Certifications & Awards ── -->
  <section class="section-sm" aria-labelledby="certs-heading">
    <div class="container certs-grid">
      <div>
        <h2 id="certs-heading" class="page-section-title">Certifications</h2>
        <ul class="plain-list">
          {CERTIFICATIONS.map(c => <li>{c}</li>)}
        </ul>
      </div>
      <div>
        <h2 class="page-section-title">Awards</h2>
        <ul class="plain-list">
          {ACHIEVEMENTS.map(a => <li>{a}</li>)}
        </ul>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
/* ── Hero ─────────────────────────────────────────────────────────────── */

.about-hero {
  border-bottom: 1px solid var(--color-border);
}

.about-hero-inner {
  display: grid;
  grid-template-columns: 1fr auto;
  gap: var(--space-12);
  align-items: center;
}

.about-h1 {
  font-size: clamp(var(--text-3xl), 5vw, var(--text-4xl));
  margin-bottom: var(--space-5);
  line-height: 1.15;
}

.about-summary {
  font-size: var(--text-lg);
  line-height: var(--leading-relaxed);
  color: var(--color-text-secondary);
  max-width: 52ch;
  margin-bottom: var(--space-8);
}

.about-actions {
  display: flex;
  gap: var(--space-3);
  flex-wrap: wrap;
}

.about-photo-wrap {
  position: relative;
  width: 200px;
  height: 240px;
  border-radius: var(--radius-2xl);
  flex-shrink: 0;
}

.about-photo-wrap::before {
  content: '';
  position: absolute;
  inset: -3px;
  border-radius: calc(var(--radius-2xl) + 3px);
  background: var(--gradient-accent);
  z-index: -1;
}

.about-photo {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center top;
  border-radius: var(--radius-2xl);
  display: block;
}

/* ── Section typography ──────────────────────────────────────────────── */

.page-section-title {
  font-size: clamp(var(--text-xl), 2.5vw, var(--text-2xl));
  font-weight: var(--font-bold);
  letter-spacing: -0.03em;
  margin-bottom: var(--space-6);
}

.section-note {
  font-size: var(--text-sm);
  color: var(--color-text-tertiary);
  margin-top: calc(-1 * var(--space-4));
  margin-bottom: var(--space-6);
  max-width: none;
}

/* ── Experience ──────────────────────────────────────────────────────── */

.exp-list {
  display: flex;
  flex-direction: column;
  gap: 0;
  border-top: 1px solid var(--color-border);
}

.exp-item {
  display: grid;
  grid-template-columns: 200px 1fr;
  gap: var(--space-8);
  padding-block: var(--space-8);
  border-bottom: 1px solid var(--color-border);
  position: relative;
}

.exp-item--current .exp-title {
  color: var(--color-text-primary);
}

.exp-item--current::before {
  content: '';
  position: absolute;
  left: -1px;
  top: 0;
  bottom: 0;
  width: 3px;
  background: var(--gradient-accent);
  border-radius: 0 2px 2px 0;
}

.exp-meta {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
  padding-top: 0.2rem;
}

.exp-period {
  font-family: var(--font-mono);
  font-size: var(--text-xs);
  color: var(--color-text-tertiary);
  line-height: var(--leading-snug);
}

.exp-current-badge {
  display: inline-block;
  padding: 0.2em 0.6em;
  border-radius: var(--radius-full);
  font-family: var(--font-mono);
  font-size: var(--text-xs);
  font-weight: var(--font-medium);
  background: var(--color-accent-muted);
  color: var(--color-accent);
  border: 1px solid var(--color-accent-border);
  width: fit-content;
}

.exp-title {
  font-size: var(--text-lg);
  font-weight: var(--font-semibold);
  letter-spacing: -0.02em;
  margin-bottom: var(--space-1);
}

.exp-org {
  font-family: var(--font-mono);
  font-size: var(--text-xs);
  color: var(--color-text-tertiary);
  margin-bottom: var(--space-4);
  max-width: none;
}

.exp-highlights {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
  padding-left: var(--space-4);
}

.exp-highlights li {
  font-size: var(--text-sm);
  color: var(--color-text-secondary);
  line-height: var(--leading-relaxed);
}

/* ── Skills (table) ──────────────────────────────────────────────────── */

.skills-section {
  background: var(--color-bg-secondary);
  border-block: 1px solid var(--color-border);
}

.skills-table {
  border-top: 1px solid var(--color-border);
}

.skill-row {
  display: grid;
  grid-template-columns: 180px 1fr;
  gap: var(--space-8);
  padding: var(--space-4) 0;
  border-bottom: 1px solid var(--color-border);
  align-items: baseline;
}

.skill-label {
  font-family: var(--font-mono);
  font-size: var(--text-xs);
  font-weight: var(--font-medium);
  color: var(--color-text-tertiary);
  flex-shrink: 0;
  line-height: var(--leading-relaxed);
}

.skill-value {
  font-size: var(--text-sm);
  color: var(--color-text-secondary);
  line-height: var(--leading-relaxed);
}

/* ── Education ───────────────────────────────────────────────────────── */

.edu-section {
  border-bottom: 1px solid var(--color-border);
}

.edu-list {
  border-top: 1px solid var(--color-border);
}

.edu-item {
  display: grid;
  grid-template-columns: 200px 1fr;
  gap: var(--space-8);
  padding-block: var(--space-8);
  border-bottom: 1px solid var(--color-border);
}

.edu-institution {
  font-size: var(--text-lg);
  font-weight: var(--font-semibold);
  letter-spacing: -0.02em;
  margin-bottom: var(--space-1);
}

.edu-location {
  font-family: var(--font-mono);
  font-size: var(--text-xs);
  color: var(--color-text-tertiary);
  margin-bottom: var(--space-3);
  max-width: none;
}

.edu-qual {
  font-size: var(--text-sm);
  color: var(--color-text-secondary);
  margin-bottom: var(--space-2);
}

.edu-result {
  font-size: var(--text-sm);
  font-weight: var(--font-semibold);
  color: var(--color-accent);
  margin-bottom: var(--space-3);
  max-width: none;
}

.edu-awards {
  list-style: none;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: var(--space-1);
}

.edu-awards li {
  font-size: var(--text-xs);
  font-family: var(--font-mono);
  color: var(--color-text-secondary);
}

/* ── Certifications ──────────────────────────────────────────────────── */

.certs-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-12);
}

.plain-list {
  list-style: none;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
  border-top: 1px solid var(--color-border);
  padding-top: var(--space-5);
}

.plain-list li {
  font-size: var(--text-sm);
  color: var(--color-text-secondary);
  line-height: var(--leading-relaxed);
}

/* ── Responsive ──────────────────────────────────────────────────────── */

@media (max-width: 768px) {
  .about-hero-inner {
    grid-template-columns: 1fr;
  }

  .about-photo-wrap {
    width: 150px;
    height: 180px;
    order: -1;
    margin-inline: auto;
  }

  .exp-item {
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  .exp-item--current::before {
    display: none;
  }

  .exp-meta {
    flex-direction: row;
    align-items: center;
    gap: var(--space-3);
  }

  .edu-item {
    grid-template-columns: 1fr;
    gap: var(--space-3);
  }

  .certs-grid {
    grid-template-columns: 1fr;
    gap: var(--space-8);
  }

  .skill-row {
    grid-template-columns: 1fr;
    gap: var(--space-1);
  }
}
</style>
