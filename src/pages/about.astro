---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import type { IconName } from '../components/icons.ts';
import {
  PROFILE,
  SKILLS,
  EXPERIENCE,
  EDUCATION,
  CERTIFICATIONS,
  ACHIEVEMENTS,
} from '../content/profile.ts';

const description = `About Ahmed - full-stack software engineer working in ASP.NET Core (C#), React and TypeScript, with experience in multi-tenant SaaS, RBAC and integrations at StudyNet Pty Ltd.`;

const SKILL_ICONS: Record<string, IconName> = {
  'Languages': 'code',
  'Frameworks': 'layers',
  'Front-End': 'monitor',
  'Back-End': 'server',
  'Databases': 'database',
  'DevOps & Tools': 'wrench',
  'Architecture': 'network',
};
---

<BaseLayout title="About" description={description}>

  <!-- ── Hero ── -->
  <section class="about-hero" aria-labelledby="about-heading">
    <div class="container about-hero-inner">

      <div class="about-hero-text">
        <h1 id="about-heading" class="about-h1 page-anim-1">
          Building applications<br/>that work.
        </h1>
        <p class="about-summary page-anim-2">{PROFILE.summary}</p>

        <div class="about-actions page-anim-3">
          {PROFILE.resumePath && (
            <a href={PROFILE.resumePath} class="btn btn-primary" download>
              <Icon name="download" size={16} />
              Download résumé
            </a>
          )}
          <a href={`mailto:${PROFILE.email}`} class="btn btn-outline">
            <Icon name="mail" size={16} />
            Send email
          </a>
          {PROFILE.linkedin && (
            <a href={PROFILE.linkedin} class="btn btn-ghost btn-icon" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn (opens in a new tab)" title="LinkedIn">
              <Icon name="linkedin" size={18} />
            </a>
          )}
          {PROFILE.github && (
            <a href={PROFILE.github} class="btn btn-ghost btn-icon" target="_blank" rel="noopener noreferrer" aria-label="GitHub (opens in a new tab)" title="GitHub">
              <Icon name="github" size={18} />
            </a>
          )}
        </div>
      </div>

      <div class="about-photo-wrap" aria-hidden="true">
        <img
          src={PROFILE.profileImage}
          alt=""
          width="240"
          height="280"
          loading="lazy"
          class="about-photo"
        />
      </div>
    </div>
  </section>

  <!-- ── Experience ── -->
  <section class="section" aria-labelledby="exp-heading">
    <div class="container">
      <div class="section-head reveal">
        <span class="icon-tile"><Icon name="briefcase" size={20} /></span>
        <h2 id="exp-heading">Experience</h2>
      </div>

      <ol class="exp-list" role="list">
        {EXPERIENCE.map((job, i) => (
          <li
            class:list={['exp-item', 'reveal', { 'exp-item--current': i === 0 }]}
            style={`transition-delay: ${i * 90}ms`}
          >
            <div class="exp-meta">
              <span class="exp-period">{job.period}</span>
              {i === 0 && <span class="status status--live"><span class="status-dot" aria-hidden="true"></span>Current</span>}
            </div>
            <div class="exp-content">
              <h3 class="exp-title">{job.title}</h3>
              <p class="exp-org">
                <Icon name="building" size={14} />{job.company}
                <span class="exp-org-sep" aria-hidden="true"></span>
                <Icon name="map-pin" size={14} />{job.location}
              </p>
              <ul class="exp-highlights">
                {job.highlights.map(h => <li>{h}</li>)}
              </ul>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ── Skills ── -->
  <section class="section-sm skills-section" aria-labelledby="skills-heading">
    <div class="container">
      <div class="section-head reveal">
        <span class="icon-tile"><Icon name="code" size={20} /></span>
        <h2 id="skills-heading">Skills</h2>
      </div>

      <dl class="skills-table reveal reveal-d1">
        {SKILLS.map(group => (
          <div class="skill-row">
            <dt class="skill-label"><Icon name={SKILL_ICONS[group.category] ?? 'code'} size={16} />{group.category}</dt>
            <dd class="skill-value">
              {group.items.map(item => <span class="badge">{item}</span>)}
            </dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- ── Education ── -->
  <section class="section-sm edu-section" aria-labelledby="edu-heading">
    <div class="container">
      <div class="section-head reveal">
        <span class="icon-tile"><Icon name="graduation-cap" size={20} /></span>
        <h2 id="edu-heading">Education</h2>
      </div>

      <div class="edu-list">
        {EDUCATION.map((edu, i) => (
          <div class="edu-item reveal" style={`transition-delay: ${i * 90}ms`}>
            <span class="exp-period">{edu.period}</span>
            <div class="edu-content">
              <h3 class="edu-institution">{edu.institution}</h3>
              <p class="edu-location">{edu.location}</p>
              <p class="edu-qual">{edu.qualification}</p>
              <p class="edu-result"><Icon name="award" size={15} />{edu.result}</p>
              {edu.awards.length > 0 && (
                <ul class="edu-awards">
                  {edu.awards.map(a => <li>{a}</li>)}
                </ul>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Certifications & Awards ── -->
  <section class="section-sm reveal" aria-labelledby="certs-heading">
    <div class="container certs-grid">
      <div>
        <div class="section-head">
          <span class="icon-tile"><Icon name="badge-check" size={20} /></span>
          <h2 id="certs-heading">Certifications</h2>
        </div>
        <ul class="plain-list">
          {CERTIFICATIONS.map(c => <li><Icon name="badge-check" size={16} />{c}</li>)}
        </ul>
      </div>
      <div>
        <div class="section-head">
          <span class="icon-tile"><Icon name="award" size={20} /></span>
          <h2>Awards</h2>
        </div>
        <ul class="plain-list">
          {ACHIEVEMENTS.map(a => <li><Icon name="award" size={16} />{a}</li>)}
        </ul>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
@media (prefers-reduced-motion: no-preference) {
  .page-anim-1 { animation: enter-up 0.7s var(--ease-out) both 0.05s; }
  .page-anim-2 { animation: enter-up 0.7s var(--ease-out) both 0.15s; }
  .page-anim-3 { animation: enter-up 0.7s var(--ease-out) both 0.25s; }
  .about-photo-wrap { animation: materialize 0.9s var(--ease-out) both 0.1s; }
}

/* ── Hero ── */

.about-hero {
  padding-block: var(--space-16);
  border-bottom: 1px solid var(--color-border);
}

.about-hero-inner {
  display: grid;
  grid-template-columns: 1fr auto;
  gap: var(--space-12);
  align-items: center;
}

.about-h1 {
  font-size: clamp(var(--text-4xl), 6vw, 4.25rem);
  margin-bottom: var(--space-6);
  line-height: 1;
  letter-spacing: -0.045em;
}

.about-summary {
  font-size: var(--text-lg);
  color: var(--color-text-secondary);
  max-width: 54ch;
  margin-bottom: var(--space-8);
}

.about-actions {
  display: flex;
  gap: var(--space-3);
  flex-wrap: wrap;
  align-items: center;
}

.about-photo-wrap {
  width: 15rem;
  aspect-ratio: 6 / 7;
  border-radius: var(--radius-2xl);
  flex-shrink: 0;
  padding: 0.375rem;
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  box-shadow: var(--shadow-xl);
  rotate: 2deg;
}

.about-photo {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center top;
  border-radius: calc(var(--radius-2xl) - 0.375rem);
}

/* ── Experience: timeline rail ── */

.exp-list {
  list-style: none;
  padding: 0;
  display: grid;
}

.exp-item {
  display: grid;
  grid-template-columns: 12rem 1fr;
  gap: var(--space-8);
}

.exp-content {
  position: relative;
  padding: 0 0 var(--space-10) var(--space-8);
  border-left: 1px solid var(--color-border);
}

.exp-item:last-child .exp-content { padding-bottom: 0; }

/* Timeline node */
.exp-content::before {
  content: '';
  position: absolute;
  left: -6px;
  top: 0.45rem;
  width: 11px;
  height: 11px;
  border-radius: 50%;
  background: var(--color-bg);
  border: 2px solid var(--color-border-strong);
}

.exp-item--current .exp-content::before {
  border-color: var(--color-success);
  background: var(--color-success);
  box-shadow: 0 0 0 4px var(--color-success-muted);
}

.exp-meta {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: var(--space-2);
  padding-top: 0.25rem;
  text-align: right;
}

.exp-period {
  font-size: var(--text-sm);
  font-weight: var(--font-medium);
  color: var(--color-text-secondary);
  font-variant-numeric: tabular-nums;
}

.exp-title {
  font-size: var(--text-xl);
  font-weight: var(--font-bold);
  margin-bottom: var(--space-2);
}

.exp-org {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: var(--space-2);
  font-size: var(--text-sm);
  color: var(--color-text-tertiary);
  margin-bottom: var(--space-4);
  max-width: none;
}

.exp-org-sep {
  width: 1px;
  height: 0.9em;
  background: var(--color-border-strong);
  margin-inline: var(--space-1);
}

.exp-highlights {
  display: grid;
  gap: var(--space-2);
  padding-left: var(--space-4);
}

.exp-highlights li {
  font-size: var(--text-sm);
  color: var(--color-text-secondary);
}

.exp-highlights li::marker { color: var(--color-text-tertiary); }

/* ── Skills ── */

.skills-section {
  background: var(--color-bg-secondary);
  border-block: 1px solid var(--color-border);
}

.skills-table {
  display: grid;
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-2xl);
  overflow: hidden;
}

.skill-row {
  display: grid;
  grid-template-columns: 13rem 1fr;
  gap: var(--space-6);
  padding: var(--space-4) var(--space-6);
  align-items: center;
}

.skill-row + .skill-row { border-top: 1px solid var(--color-border); }

.skill-label {
  display: inline-flex;
  align-items: center;
  gap: var(--space-2);
  font-size: var(--text-sm);
  font-weight: var(--font-semibold);
  color: var(--color-text-primary);
}

.skill-label :global(svg) { color: var(--color-accent); }

.skill-value {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2);
}

/* ── Education ── */

.edu-section { border-bottom: 1px solid var(--color-border); }

.edu-list {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(min(18rem, 100%), 1fr));
  gap: var(--space-4);
}

.edu-item {
  display: grid;
  gap: var(--space-3);
  align-content: start;
  padding: var(--space-6);
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-xl);
}

.edu-institution {
  font-size: var(--text-xl);
  font-weight: var(--font-bold);
  margin-bottom: var(--space-1);
}

.edu-location {
  font-size: var(--text-sm);
  color: var(--color-text-tertiary);
  margin-bottom: var(--space-3);
  max-width: none;
}

.edu-qual {
  font-size: var(--text-sm);
  color: var(--color-text-secondary);
  margin-bottom: var(--space-3);
}

.edu-result {
  display: inline-flex;
  align-items: center;
  gap: var(--space-2);
  font-size: var(--text-sm);
  font-weight: var(--font-semibold);
  color: var(--color-accent);
  margin-bottom: var(--space-3);
  max-width: none;
}

.edu-awards {
  list-style: none;
  padding: 0;
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2);
}

.edu-awards li {
  font-size: var(--text-xs);
  font-weight: var(--font-medium);
  color: var(--color-text-secondary);
  padding: 0.25rem 0.65rem;
  border-radius: var(--radius-full);
  background: var(--color-bg-secondary);
  border: 1px solid var(--color-border);
}

/* ── Certifications & awards ── */

.certs-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-12);
}

.certs-grid .section-head { margin-bottom: var(--space-5); }

.plain-list {
  list-style: none;
  padding: 0;
  display: grid;
  gap: var(--space-3);
}

.plain-list li {
  display: flex;
  align-items: flex-start;
  gap: var(--space-3);
  font-size: var(--text-sm);
  color: var(--color-text-secondary);
}

.plain-list li :global(svg) { color: var(--color-text-tertiary); margin-top: 0.2rem; }

/* ── Responsive ── */

@media (max-width: 768px) {
  .about-hero { padding-block: var(--space-10); }
  .about-hero-inner { grid-template-columns: 1fr; gap: var(--space-8); }

  .about-photo-wrap {
    width: 9rem;
    order: -1;
  }

  .exp-item {
    grid-template-columns: 1fr;
    gap: var(--space-3);
  }

  /* Period sits on the rail, above its role */
  .exp-meta {
    flex-direction: row;
    align-items: center;
    gap: var(--space-3);
    text-align: left;
    padding: 0 0 0 var(--space-8);
    border-left: 1px solid var(--color-border);
    margin-bottom: calc(-1 * var(--space-3));
    padding-bottom: var(--space-3);
  }

  .exp-content::before { top: -1.6rem; }

  .certs-grid { grid-template-columns: 1fr; gap: var(--space-10); }

  .skill-row {
    grid-template-columns: 1fr;
    gap: var(--space-3);
    padding: var(--space-4);
  }
}
</style>
