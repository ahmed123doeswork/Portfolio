---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Avatar from '../components/Avatar.tsx';
import Icon from '../components/Icon.astro';
import ProofFeed from '../components/ProofFeed.astro';
import type { IconName } from '../components/icons.ts';
import { PROFILE, SKILLS, EXPERIENCE } from '../content/profile.ts';
import { PROJECTS, STATUS_LABEL } from '../content/projects.ts';
import jobHuntDashboard from '../assets/projects/jobhunt/dashboard.png';
import jobHuntAts from '../assets/projects/jobhunt/ats-check.png';

const currentRole = EXPERIENCE[0];
const featured = PROJECTS.find(p => p.id === 'jobhunt')!;
const others = PROJECTS.filter(p => p.id !== 'jobhunt' && p.status === 'demo');

const SKILL_ICONS: Record<string, IconName> = {
  'Languages': 'code',
  'Frameworks': 'layers',
  'Front-End': 'monitor',
  'Back-End': 'server',
  'Databases': 'database',
  'DevOps & Tools': 'wrench',
  'Architecture': 'network',
};

const description = `Ahmed - Full-Stack Software Engineer building scalable web applications with ASP.NET Core (C#), React, TypeScript, and PostgreSQL/MySQL.`;
---

<BaseLayout title="Home" description={description}>

  <!-- ── Hero ── -->
  <section class="hero" aria-labelledby="hero-heading">
    <div class="container hero-inner">

      <div class="hero-text">
        <p class="hero-intro hero-anim-1">
          <img src={PROFILE.profileImage} alt="" width="40" height="40" class="hero-intro-photo" loading="eager" />
          <span class="hero-intro-text">
            <span class="hero-intro-name">Ahmed</span>
            <span class="hero-intro-role">Full-stack software engineer</span>
          </span>
        </p>

        <h1 id="hero-heading" class="hero-display hero-anim-2">
          Web apps that stay correct when two people press Save at once.
        </h1>

        <p class="hero-body hero-anim-3">{PROFILE.summary}</p>

        <div class="hero-actions hero-anim-4">
          <a href="/projects" class="btn btn-primary">
            See projects
            <Icon name="arrow-right" size={16} class="icon-arrow" />
          </a>
          <a href="#contact" class="btn btn-outline">
            <Icon name="send" size={16} />
            Get in touch
          </a>
          {PROFILE.resumePath && (
            <a href={PROFILE.resumePath} class="btn btn-ghost" download>
              <Icon name="download" size={16} />
              Résumé
            </a>
          )}
        </div>

        <ul class="hero-meta hero-anim-5" role="list">
          <li><Icon name="map-pin" size={16} />{PROFILE.location}</li>
          <li><Icon name="building" size={16} />{currentRole.company}</li>
          <li><Icon name="graduation-cap" size={16} />BSc CSE, CGPA 3.98</li>
        </ul>
      </div>

      <div class="hero-feed hero-anim-feed">
        <ProofFeed />
      </div>

    </div>
  </section>

  <!-- ── Currently ── -->
  <section class="current-section" aria-labelledby="current-heading">
    <div class="container">
      <div class="current-inner reveal">
        <div class="current-label">
          <span class="current-dot" aria-hidden="true"></span>
          <span id="current-heading">Currently</span>
        </div>
        <div class="current-body">
          <h2 class="current-title">{currentRole.title}</h2>
          <p class="current-where">
            <Icon name="building" size={14} />{currentRole.company}, {currentRole.location}
            <span class="current-period">{currentRole.period}</span>
          </p>
          <p class="current-desc">
            Leading full-stack development of Scholly, a multi-tenant SaaS platform, with ASP.NET Core, React/TypeScript, and MySQL. Architecting RBAC, tenant isolation, and Bitrix24 workflow automation.
          </p>
        </div>
        <a href="/about" class="link-arrow current-cta">
          Full experience
          <Icon name="arrow-right" size={16} class="icon-arrow" />
        </a>
      </div>
    </div>
  </section>

  <!-- ── Projects ── -->
  <section class="projects-section section" aria-labelledby="projects-heading">
    <div class="container">
      <div class="projects-header reveal">
        <div class="section-head">
          <span class="icon-tile"><Icon name="folder" size={20} /></span>
          <h2 id="projects-heading">Projects</h2>
        </div>
        <a href="/projects" class="link-arrow">
          All projects
          <Icon name="arrow-right" size={16} class="icon-arrow" />
        </a>
      </div>
      <p class="projects-intro reveal">
        Four projects in C#, Python, PHP and TypeScript, each with public source code. The three hosted demos run in your browser on sample data.
      </p>

      <!-- Featured: newest project -->
      <article class="feature reveal" aria-labelledby="feature-title">
        <div class="feature-text">
          <div class="feature-tags">
            {featured.isNew && (
              <span class="badge badge-accent"><Icon name="sparkles" size={13} />New</span>
            )}
            <span class="status status--local"><Icon name="laptop" size={13} />{STATUS_LABEL[featured.status]}</span>
          </div>

          <h3 id="feature-title" class="feature-name">{featured.name}</h3>
          <p class="feature-tagline">{featured.tagline}</p>
          <p class="feature-summary">{featured.summary}</p>

          <ul class="feature-points" role="list">
            <li>
              <span class="feature-point-icon"><Icon name="file-text" size={16} /></span>
              <span><strong>CV builder with an ATS score.</strong> Every flagged issue has a Fix button; export to PDF or Word.</span>
            </li>
            <li>
              <span class="feature-point-icon"><Icon name="search" size={16} /></span>
              <span><strong>Four job sites, one ranked list.</strong> Wrong-level, wrong-city and excluded jobs are filtered out.</span>
            </li>
            <li>
              <span class="feature-point-icon"><Icon name="lock" size={16} /></span>
              <span><strong>Runs on your PC.</strong> No account, and your CV never leaves your computer.</span>
            </li>
          </ul>

          <div class="feature-actions">
            {featured.sourceUrl && (
              <a href={featured.sourceUrl} class="btn btn-primary" target="_blank" rel="noopener noreferrer">
                <Icon name="github" size={16} />
                View source
                <span class="visually-hidden">(opens in a new tab)</span>
              </a>
            )}
            <a href={`/projects#${featured.id}`} class="btn btn-outline">
              How it works
              <Icon name="arrow-right" size={16} class="icon-arrow" />
            </a>
          </div>
        </div>

        <figure class="feature-shots">
          <div class="shot shot-back">
            <Image src={jobHuntAts} alt="" widths={[480, 720]} sizes="(max-width: 960px) 70vw, 380px" loading="lazy" />
          </div>
          <div class="shot shot-front">
            <Image
              src={jobHuntDashboard}
              alt="Job Hunt dashboard: jobs ranked by match score, with filters by work mode, role and source, and the selected job's details."
              widths={[640, 960, 1280]}
              sizes="(max-width: 960px) 92vw, 560px"
              loading="lazy"
            />
          </div>
          <figcaption class="feature-caption">Screenshots use a fictional profile and sample listings.</figcaption>
        </figure>
      </article>

      <!-- Hosted-demo projects -->
      <ul class="project-list reveal" role="list">
        {others.map((project) => (
          <li class="project-row">
            <span class="project-icon"><Icon name={project.icon} size={20} /></span>
            <div class="project-info">
              <div class="project-title-row">
                <h3 class="project-name">{project.name}</h3>
                <span class="status status--live"><span class="status-dot" aria-hidden="true"></span>{STATUS_LABEL[project.status]}</span>
              </div>
              <p class="project-desc">{project.summary}</p>
              <div class="project-stack">
                {project.stack.map(t => <span class="badge">{t}</span>)}
              </div>
            </div>
            <div class="project-links">
              {project.demoUrl && (
                <a href={project.demoUrl} class="btn btn-outline btn-sm" target="_blank" rel="noopener noreferrer">
                  <Icon name="globe" size={15} />
                  Demo
                  <span class="visually-hidden">: {project.name} (opens in a new tab)</span>
                </a>
              )}
              {project.sourceUrl && (
                <a href={project.sourceUrl} class="btn btn-ghost btn-sm" target="_blank" rel="noopener noreferrer">
                  <Icon name="github" size={15} />
                  Source
                  <span class="visually-hidden">: {project.name} (opens in a new tab)</span>
                </a>
              )}
              <a href={`/projects#${project.id}`} class="btn btn-ghost btn-sm btn-icon" aria-label={`${project.name} details`} title="Details">
                <Icon name="arrow-right" size={16} class="icon-arrow" />
              </a>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ── Skills ── -->
  <section class="skills-section section" aria-labelledby="skills-heading">
    <div class="container">
      <div class="section-head reveal">
        <span class="icon-tile"><Icon name="code" size={20} /></span>
        <h2 id="skills-heading">Skills</h2>
      </div>

      <ul class="skills-grid" role="list">
        {SKILLS.map((group, i) => (
          <li class:list={['skill-group', 'reveal', `reveal-d${Math.min(i, 5)}`]}>
            <h3 class="skill-label">
              <Icon name={SKILL_ICONS[group.category] ?? 'code'} size={16} />
              {group.category}
            </h3>
            <ul class="skill-chips" role="list">
              {group.items.map(item => <li class="badge">{item}</li>)}
            </ul>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ── Contact ── -->
  <section class="contact-section section" id="contact" aria-labelledby="contact-heading">
    <div class="container">
      <div class="contact-panel reveal">
        <div class="contact-text">
          <span class="icon-tile contact-tile"><Icon name="send" size={20} /></span>
          <h2 id="contact-heading" class="contact-title">Get in touch</h2>
          <p class="contact-body">
            Open to engineering roles and technical discussions. I read every message.
          </p>
        </div>

        <ul class="contact-links" role="list">
          <li class="contact-item">
            <a href={`mailto:${PROFILE.email}`} class="contact-link">
              <span class="contact-link-icon"><Icon name="mail" size={18} /></span>
              <span class="contact-link-text">
                <span class="contact-link-label">Email</span>
                <span class="contact-link-value">{PROFILE.email}</span>
              </span>
            </a>
            <button type="button" class="contact-copy" data-copy={PROFILE.email} aria-label="Copy email address">
              <span class="copy-icon copy-icon-idle"><Icon name="copy" size={16} /></span>
              <span class="copy-icon copy-icon-done"><Icon name="check" size={16} strokeWidth={2.4} /></span>
            </button>
          </li>

          {PROFILE.linkedin && (
            <li class="contact-item">
              <a href={PROFILE.linkedin} target="_blank" rel="noopener noreferrer" class="contact-link">
                <span class="contact-link-icon"><Icon name="linkedin" size={18} /></span>
                <span class="contact-link-text">
                  <span class="contact-link-label">LinkedIn</span>
                  <span class="contact-link-value">linkedin.com/in/onlyahmed</span>
                </span>
                <Icon name="arrow-up-right" size={16} class="icon-arrow contact-ext" />
                <span class="visually-hidden">(opens in a new tab)</span>
              </a>
            </li>
          )}

          {PROFILE.github && (
            <li class="contact-item">
              <a href={PROFILE.github} target="_blank" rel="noopener noreferrer" class="contact-link">
                <span class="contact-link-icon"><Icon name="github" size={18} /></span>
                <span class="contact-link-text">
                  <span class="contact-link-label">GitHub</span>
                  <span class="contact-link-value">{PROFILE.github.replace('https://', '')}</span>
                </span>
                <Icon name="arrow-up-right" size={16} class="icon-arrow contact-ext" />
                <span class="visually-hidden">(opens in a new tab)</span>
              </a>
            </li>
          )}

          {PROFILE.resumePath && (
            <li class="contact-item">
              <a href={PROFILE.resumePath} class="contact-link" download>
                <span class="contact-link-icon"><Icon name="file-text" size={18} /></span>
                <span class="contact-link-text">
                  <span class="contact-link-label">Résumé</span>
                  <span class="contact-link-value">Download PDF</span>
                </span>
                <Icon name="download" size={16} class="contact-ext icon-download" />
              </a>
            </li>
          )}
        </ul>
        <p class="visually-hidden" role="status" data-copy-status></p>
      </div>
    </div>
  </section>

  <!-- Fixed bottom-right avatar guide -->
  <div class="avatar-fixed" aria-label="Portfolio guide widget">
    <Avatar client:load />
  </div>

</BaseLayout>

<script>
  function initCopy() {
    const status = document.querySelector<HTMLElement>('[data-copy-status]');
    document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach(btn => {
      if (btn.dataset.ready) return;
      btn.dataset.ready = 'true';
      if (!navigator.clipboard) { btn.hidden = true; return; }
      let timer: number | undefined;
      btn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(btn.dataset.copy ?? '');
          btn.classList.add('is-done');
          btn.setAttribute('aria-label', 'Email address copied');
          if (status) status.textContent = 'Email address copied to clipboard.';
        } catch {
          if (status) status.textContent = 'Copy failed. Select the address to copy it.';
          return;
        }
        window.clearTimeout(timer);
        timer = window.setTimeout(() => {
          btn.classList.remove('is-done');
          btn.setAttribute('aria-label', 'Copy email address');
          if (status) status.textContent = '';
        }, 2000);
      });
    });
  }
  document.addEventListener('astro:page-load', initCopy);
</script>

<style>
/* ── Hero entrance: one orchestrated sequence ────────────────────────── */

@media (prefers-reduced-motion: no-preference) {
  .hero-anim-1 { animation: enter-up 0.7s var(--ease-out) both 0.05s; }
  .hero-anim-2 { animation: enter-up 0.7s var(--ease-out) both 0.14s; }
  .hero-anim-3 { animation: enter-up 0.7s var(--ease-out) both 0.24s; }
  .hero-anim-4 { animation: enter-up 0.7s var(--ease-out) both 0.32s; }
  .hero-anim-5 { animation: enter-up 0.7s var(--ease-out) both 0.4s; }
  .hero-anim-feed { animation: materialize 0.9s var(--ease-out) both 0.3s; }
}

/* ── Hero ─────────────────────────────────────────────────────────────── */

.hero {
  padding-block: var(--space-16) var(--space-20);
  position: relative;
  overflow: clip;
}

/* Quiet dot grid behind the feed: structure, not decoration wash */
.hero::before {
  content: '';
  position: absolute;
  inset: 0 0 0 45%;
  background-image: radial-gradient(var(--color-border) 1px, transparent 1px);
  background-size: 22px 22px;
  mask-image: radial-gradient(ellipse 60% 70% at 60% 45%, #000 20%, transparent 75%);
  -webkit-mask-image: radial-gradient(ellipse 60% 70% at 60% 45%, #000 20%, transparent 75%);
  pointer-events: none;
  z-index: -1;
}

.hero-inner {
  display: grid;
  grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
  align-items: center;
  gap: var(--space-16);
  min-height: calc(100dvh - var(--nav-height) - 9rem);
}

.hero-intro {
  display: inline-flex;
  align-items: center;
  gap: var(--space-3);
  margin-bottom: var(--space-6);
  max-width: none;
}

.hero-intro-photo {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  object-fit: cover;
  object-position: center top;
  box-shadow: 0 0 0 2px var(--color-surface), 0 0 0 3px var(--color-border);
}

.hero-intro-text {
  display: grid;
  line-height: 1.25;
}

.hero-intro-name {
  font-family: var(--font-display);
  font-weight: var(--font-bold);
  color: var(--color-text-primary);
  font-size: var(--text-base);
}

.hero-intro-role {
  font-size: var(--text-sm);
  color: var(--color-text-tertiary);
}

.hero-display {
  font-size: clamp(2.4rem, 5.2vw, 4.25rem);
  font-weight: var(--font-bold);
  line-height: 1.04;
  letter-spacing: -0.032em;
  margin-bottom: var(--space-6);
  max-width: 14ch;
  font-variation-settings: 'opsz' 96;
}

.hero-body {
  font-size: var(--text-lg);
  line-height: var(--leading-relaxed);
  color: var(--color-text-secondary);
  max-width: 50ch;
  margin-bottom: var(--space-8);
}

.hero-actions {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-3);
  align-items: center;
  margin-bottom: var(--space-8);
}

.hero-meta {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2) var(--space-5);
  list-style: none;
  padding: 0;
  font-size: var(--text-sm);
  color: var(--color-text-tertiary);
}

.hero-meta li {
  display: inline-flex;
  align-items: center;
  gap: var(--space-2);
}

.hero-meta :global(svg) { color: var(--color-text-tertiary); }

.hero-feed { min-width: 0; }

/* ── Currently ───────────────────────────────────────────────────────── */

.current-section {
  padding-block: var(--space-10);
  background: var(--color-bg-secondary);
  border-block: 1px solid var(--color-border);
}

.current-inner {
  display: grid;
  grid-template-columns: 9rem 1fr auto;
  gap: var(--space-8);
  align-items: start;
}

.current-label {
  display: inline-flex;
  align-items: center;
  gap: var(--space-2);
  font-size: var(--text-sm);
  font-weight: var(--font-semibold);
  color: var(--color-success);
  padding-top: 0.3rem;
}

.current-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: currentColor;
  box-shadow: 0 0 0 3px var(--color-success-muted);
}

@media (prefers-reduced-motion: no-preference) {
  .current-dot { animation: status-pulse 2.4s var(--ease-in-out) infinite; }
}

.current-title {
  font-size: var(--text-xl);
  font-weight: var(--font-bold);
  margin-bottom: var(--space-2);
}

.current-where {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: var(--space-2);
  font-size: var(--text-sm);
  color: var(--color-text-secondary);
  margin-bottom: var(--space-3);
  max-width: none;
}

.current-period {
  color: var(--color-text-tertiary);
  padding-left: var(--space-2);
  border-left: 1px solid var(--color-border-strong);
}

.current-desc {
  font-size: var(--text-sm);
  color: var(--color-text-secondary);
  max-width: 60ch;
}

.current-cta {
  align-self: center;
  white-space: nowrap;
}

/* ── Projects ────────────────────────────────────────────────────────── */

.projects-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-4);
  flex-wrap: wrap;
  margin-bottom: var(--space-3);
}

.projects-header .section-head { margin-bottom: 0; }

.projects-intro {
  font-size: var(--text-base);
  color: var(--color-text-secondary);
  margin-bottom: var(--space-10);
  max-width: 62ch;
}

/* Featured panel */
.feature {
  display: grid;
  grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
  gap: var(--space-12);
  align-items: center;
  padding: var(--space-10);
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-2xl);
  box-shadow: var(--shadow-md);
  margin-bottom: var(--space-8);
  overflow: clip;
}

.feature-tags {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2);
  margin-bottom: var(--space-5);
}

.feature-name {
  font-size: clamp(var(--text-3xl), 4vw, var(--text-5xl));
  letter-spacing: -0.04em;
  line-height: 1;
  margin-bottom: var(--space-2);
}

.feature-tagline {
  font-size: var(--text-lg);
  font-weight: var(--font-medium);
  color: var(--color-text-primary);
  margin-bottom: var(--space-4);
}

.feature-summary {
  color: var(--color-text-secondary);
  margin-bottom: var(--space-6);
}

.feature-points {
  list-style: none;
  padding: 0;
  display: grid;
  gap: var(--space-4);
  margin-bottom: var(--space-8);
}

.feature-points li {
  display: grid;
  grid-template-columns: auto 1fr;
  gap: var(--space-3);
  font-size: var(--text-sm);
  color: var(--color-text-secondary);
}

.feature-point-icon {
  display: grid;
  place-items: center;
  width: 2rem;
  height: 2rem;
  border-radius: var(--radius-md);
  background: var(--color-accent-muted);
  color: var(--color-accent);
}

.feature-actions {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-3);
}

/* Layered screenshots: depth by offset + shadow, the back one slides out on hover */
.feature-shots {
  position: relative;
  aspect-ratio: 16 / 12;
  margin: 0;
}

.shot {
  position: absolute;
  border-radius: var(--radius-lg);
  overflow: hidden;
  background: var(--color-bg-secondary);
  border: 1px solid var(--color-border);
  transition: transform 0.6s var(--ease-out), box-shadow 0.6s var(--ease-out);
}

.shot :global(img) {
  width: 100%;
  height: auto;
  display: block;
}

.shot-back {
  width: 72%;
  top: 0;
  right: 0;
  box-shadow: var(--shadow-md);
  transform: rotate(2deg);
  opacity: 0.92;
}

.shot-front {
  width: 88%;
  left: 0;
  bottom: 2.25rem;
  box-shadow: var(--shadow-xl);
}

@media (hover: hover) and (prefers-reduced-motion: no-preference) {
  .feature:hover .shot-back  { transform: rotate(3.5deg) translate(10px, -8px); }
  .feature:hover .shot-front { transform: translateY(-4px); }
}

.feature-caption {
  position: absolute;
  left: 0;
  bottom: 0;
  font-size: var(--text-xs);
  color: var(--color-text-tertiary);
}

/* Hosted-demo projects: one panel, rows divided by hairlines */
.project-list {
  list-style: none;
  padding: 0;
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-2xl);
  overflow: hidden;
}

.project-row {
  display: grid;
  grid-template-columns: auto minmax(0, 1fr) auto;
  gap: var(--space-5);
  align-items: start;
  padding: var(--space-6);
  transition: background-color var(--transition-fast);
}

.project-row + .project-row { border-top: 1px solid var(--color-border); }
.project-row:hover { background: color-mix(in srgb, var(--color-bg-secondary) 55%, transparent); }

.project-icon {
  display: grid;
  place-items: center;
  width: 2.75rem;
  height: 2.75rem;
  border-radius: var(--radius-md);
