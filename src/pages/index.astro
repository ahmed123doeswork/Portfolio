---
import BaseLayout from '../layouts/BaseLayout.astro';
import Avatar from '../components/Avatar.tsx';
import { PROFILE, SKILLS, EXPERIENCE } from '../content/profile.ts';

const currentRole = EXPERIENCE[0];

const description = `Ahmed - software engineer building CRM systems, REST APIs, and workflow automation with PHP, Python, and JavaScript.`;
---

<BaseLayout title="Home" description={description}>

  <!-- ── Hero ── -->
  <section class="hero" aria-labelledby="hero-heading">
    <div class="container hero-inner">

      <div class="hero-text">
        <h1 id="hero-heading" class="hero-display hero-anim-1">
          Ahmed
        </h1>
        <p class="hero-stack hero-anim-2">{PROFILE.headline}</p>
        <p class="hero-body hero-anim-3">{PROFILE.summary}</p>

        <div class="hero-actions hero-anim-4">
          <a href="/projects" class="btn btn-primary">See projects</a>
          <a href="#contact"  class="btn btn-outline">Get in touch</a>
          {PROFILE.resumePath && (
            <a
              href={PROFILE.resumePath}
              class="btn btn-ghost"
              target="_blank"
              rel="noopener noreferrer"
              download
            >
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                <polyline points="7 10 12 15 17 10"/>
                <line x1="12" y1="15" x2="12" y2="3"/>
              </svg>
              Résumé
            </a>
          )}
        </div>

        <div class="hero-meta hero-anim-5">
          <span>{PROFILE.location}</span>
          <span class="hero-meta-sep" aria-hidden="true">·</span>
          <a href={PROFILE.linkedin} target="_blank" rel="noopener noreferrer">StudyNet</a>
          <span class="hero-meta-sep" aria-hidden="true">·</span>
          <span>BSc CSE, 3.98 GPA</span>
        </div>
      </div>

      <div class="hero-photo-wrap hero-anim-photo" aria-hidden="true">
        <img
          src={PROFILE.profileImage}
          alt="Photo of Ahmed"
          class="hero-photo"
          width="300"
          height="340"
          loading="eager"
        />
      </div>

    </div>
  </section>

  <!-- ── Currently ── -->
  <section class="current-section reveal" aria-labelledby="current-heading">
    <div class="container">
      <div class="current-inner">
        <div class="current-label-col">
          <span class="current-label" id="current-heading">Currently</span>
          <span class="current-dot" aria-hidden="true"></span>
        </div>
        <div class="current-body">
          <h2 class="current-title">{currentRole.title}</h2>
          <p class="current-where">{currentRole.company}, {currentRole.location} &nbsp;·&nbsp; {currentRole.period}</p>
          <p class="current-desc">
            Developing the Scholly platform with PHP/CodeIgniter, Bitrix24 integrations, RESTful APIs, and MySQL. Leading full-stack feature delivery and CRM workflow automation.
          </p>
        </div>
        <a href="/about" class="btn btn-ghost current-cta">Full experience →</a>
      </div>
    </div>
  </section>

  <!-- ── Skills ── -->
  <section class="skills-section section-sm" aria-labelledby="skills-heading">
    <div class="container">
      <h2 id="skills-heading" class="section-title reveal">Skills</h2>

      <div class="skills-table reveal reveal-d1" role="table" aria-label="Technical skills by category">
        {SKILLS.map(group => (
          <div class="skill-row" role="row">
            <span class="skill-label" role="rowheader">{group.category}</span>
            <span class="skill-value" role="cell">
              {group.items.join(' · ')}
            </span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Projects ── -->
  <section class="projects-section section-sm" aria-labelledby="projects-heading">
    <div class="container">
      <div class="projects-header">
        <h2 id="projects-heading" class="section-title">Projects</h2>
        <a href="/projects" class="btn btn-ghost projects-all">All projects →</a>
      </div>
      <p class="projects-intro">
        Three focused backend engineering demonstrations - PHP, Python, and C#. Each will include source code, Docker Compose startup, and an interactive browser simulation.
      </p>

      <div class="project-list">

        <article class="project-item reveal" aria-labelledby="proj-workflowdesk">
          <div class="project-row">
            <div class="project-info">
              <h3 id="proj-workflowdesk" class="project-name">WorkflowDesk</h3>
              <p class="project-desc">
                Multi-tenant enquiry management with role-based access, configurable state transitions, and audit history. Backend-enforced tenant isolation with transactional changes.
              </p>
              <p class="project-coming">Case study coming soon.</p>
            </div>
            <div class="project-stack">
              {['PHP', 'Laravel', 'Vue', 'MySQL'].map(t => (
                <span class="badge">{t}</span>
              ))}
            </div>
          </div>
        </article>

        <article class="project-item reveal reveal-d1" aria-labelledby="proj-databridge">
          <div class="project-row">
            <div class="project-info">
              <h3 id="proj-databridge" class="project-name">DataBridge Inspector</h3>
              <p class="project-desc">
                CSV contact normalisation tool with explainable duplicate detection, field validation, normalisation preview, and safe export. Input limits enforced; originals preserved.
              </p>
              <p class="project-coming">Case study coming soon.</p>
            </div>
            <div class="project-stack">
              {['Python', 'FastAPI', 'React'].map(t => (
                <span class="badge">{t}</span>
              ))}
            </div>
          </div>
        </article>

        <article class="project-item reveal reveal-d2" aria-labelledby="proj-timeslot">
          <div class="project-row">
            <div class="project-info">
              <h3 id="proj-timeslot" class="project-name">TimeSlot</h3>
              <p class="project-desc">
                Timezone-aware appointment booking with UTC storage, IANA zone identifiers, database-level conflict protection, and idempotent atomic rescheduling.
              </p>
              <p class="project-coming">Case study coming soon.</p>
            </div>
            <div class="project-stack">
              {['C#', 'ASP.NET Core', 'React', 'PostgreSQL'].map(t => (
                <span class="badge">{t}</span>
              ))}
            </div>
          </div>
        </article>

      </div>
    </div>
  </section>

  <!-- ── Contact ── -->
  <section class="contact-section section reveal" id="contact" aria-labelledby="contact-heading">
    <div class="container contact-inner">

      <div class="contact-text">
        <h2 id="contact-heading" class="section-title">Get in touch</h2>
        <p class="contact-body">
          Open to engineering roles and technical discussions.<br/>
          I read every message.
        </p>
      </div>

      <div class="contact-links">
        <a href={`mailto:${PROFILE.email}`} class="contact-link">
          <span class="contact-link-icon" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
          </span>
          <span class="contact-link-text">{PROFILE.email}</span>
        </a>

        {PROFILE.linkedin && (
          <a href={PROFILE.linkedin} target="_blank" rel="noopener noreferrer" class="contact-link">
            <span class="contact-link-icon" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
            </span>
            <span class="contact-link-text">linkedin.com/in/onlyahmed</span>
          </a>
        )}

        {PROFILE.github && (
          <a href={PROFILE.github} target="_blank" rel="noopener noreferrer" class="contact-link">
            <span class="contact-link-icon" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/></svg>
            </span>
            <span class="contact-link-text">{PROFILE.github.replace('https://', '')}</span>
          </a>
        )}
      </div>

    </div>
  </section>

  <!-- Fixed bottom-right avatar guide -->
  <div class="avatar-fixed" aria-label="Portfolio guide widget">
    <Avatar client:load />
  </div>

</BaseLayout>

<style>
/* ── Hero entrance animations ─────────────────────────────────────────── */

@media (prefers-reduced-motion: no-preference) {
  .hero-anim-1 { animation: enter-up 0.65s cubic-bezier(0.16, 1, 0.3, 1) both; animation-delay: 0.05s; }
  .hero-anim-2 { animation: enter-up 0.65s cubic-bezier(0.16, 1, 0.3, 1) both; animation-delay: 0.18s; }
  .hero-anim-3 { animation: enter-up 0.65s cubic-bezier(0.16, 1, 0.3, 1) both; animation-delay: 0.3s;  }
  .hero-anim-4 { animation: enter-up 0.65s cubic-bezier(0.16, 1, 0.3, 1) both; animation-delay: 0.42s; }
  .hero-anim-5 { animation: enter-up 0.65s cubic-bezier(0.16, 1, 0.3, 1) both; animation-delay: 0.52s; }
  .hero-anim-photo { animation: enter-up 0.7s cubic-bezier(0.16, 1, 0.3, 1) both; animation-delay: 0.1s; }
}

/* ── Hero ─────────────────────────────────────────────────────────────── */

.hero {
  padding-block: var(--space-16) var(--space-20);
  position: relative;
}

.hero-inner {
  display: grid;
  grid-template-columns: 1fr auto;
  align-items: center;
  gap: var(--space-16);
  min-height: calc(100dvh - var(--nav-height) - 8rem);
}

.hero-display {
  font-size: clamp(3.25rem, 8vw, 6rem);
  font-weight: var(--font-extrabold);
  line-height: 1.0;
  letter-spacing: -0.04em;
  margin-bottom: var(--space-5);
  color: var(--color-text-primary);
}

.hero-stack {
  font-family: var(--font-mono);
  font-size: var(--text-sm);
  color: var(--color-accent);
  margin-bottom: var(--space-6);
  max-width: none;
}

.hero-body {
  font-size: var(--text-lg);
  line-height: var(--leading-relaxed);
  color: var(--color-text-secondary);
  max-width: 46ch;
  margin-bottom: var(--space-8);
}

.hero-actions {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-3);
  align-items: center;
  margin-bottom: var(--space-8);
}

.hero-meta {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  font-size: var(--text-sm);
  color: var(--color-text-tertiary);
  flex-wrap: wrap;
}

.hero-meta a {
  color: var(--color-text-tertiary);
  text-decoration: none;
  transition: color var(--transition-fast);
}

.hero-meta a:hover {
  color: var(--color-accent);
}

.hero-meta-sep {
  opacity: 0.4;
}

/* Photo */
.hero-photo-wrap {
  position: relative;
  width: 260px;
  height: 300px;
  border-radius: var(--radius-2xl);
  flex-shrink: 0;
}

.hero-photo-wrap::before {
  content: '';
  position: absolute;
  inset: -3px;
  border-radius: calc(var(--radius-2xl) + 3px);
  background: var(--gradient-accent);
  z-index: -1;
}

.hero-photo {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center top;
  border-radius: var(--radius-2xl);
  display: block;
}

/* ── Currently ───────────────────────────────────────────────────────── */

.current-section {
  padding-block: var(--space-10);
  background: var(--color-bg-secondary);
  border-block: 1px solid var(--color-border);
}

.current-inner {
  display: grid;
  grid-template-columns: 120px 1fr auto;
  gap: var(--space-8);
  align-items: start;
}

.current-label-col {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: var(--space-3);
  padding-top: 0.2rem;
}

.current-label {
  font-family: var(--font-mono);
  font-size: var(--text-xs);
  font-weight: var(--font-medium);
  color: var(--color-accent);
  letter-spacing: 0.02em;
}

.current-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--color-accent);
  box-shadow: 0 0 0 3px var(--color-accent-muted), 0 0 12px var(--color-accent-muted);
  animation: dot-pulse 2.5s ease-in-out infinite;
}

@keyframes dot-pulse {
  0%, 100% { opacity: 1; }
  50%       { opacity: 0.4; }
}

@media (prefers-reduced-motion: reduce) {
  .current-dot { animation: none; }
}

.current-title {
  font-size: var(--text-xl);
  font-weight: var(--font-bold);
  margin-bottom: var(--space-2);
  letter-spacing: -0.02em;
}

.current-where {
  font-size: var(--text-sm);
  color: var(--color-text-tertiary);
  margin-bottom: var(--space-3);
  font-family: var(--font-mono);
  max-width: none;
}

.current-desc {
  font-size: var(--text-sm);
  color: var(--color-text-secondary);
  line-height: var(--leading-relaxed);
  max-width: 52ch;
}

.current-cta {
  align-self: center;
  flex-shrink: 0;
  white-space: nowrap;
}

/* ── Skills ──────────────────────────────────────────────────────────── */

.skills-section {
  /* inherits section-sm padding */
}

.section-title {
  font-size: clamp(var(--text-xl), 2.5vw, var(--text-2xl));
  font-weight: var(--font-bold);
  letter-spacing: -0.03em;
  margin-bottom: var(--space-6);
}

.skills-table {
  border-top: 1px solid var(--color-border);
}

.skill-row {
  display: grid;
  grid-template-columns: 180px 1fr;
  gap: var(--space-8);
  padding: var(--space-4) 0;
  border-bottom: 1px solid var(--color-border);
  align-items: baseline;
}

.skill-label {
  font-family: var(--font-mono);
  font-size: var(--text-xs);
  font-weight: var(--font-medium);
  color: var(--color-text-tertiary);
  flex-shrink: 0;
  line-height: var(--leading-relaxed);
}

.skill-value {
  font-size: var(--text-sm);
  color: var(--color-text-secondary);
  line-height: var(--leading-relaxed);
}

/* ── Projects ────────────────────────────────────────────────────────── */

.projects-section {
  background: var(--color-bg-secondary);
  border-block: 1px solid var(--color-border);
}

.projects-header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: var(--space-4);
  flex-wrap: wrap;
}

.projects-intro {
  font-size: var(--text-sm);
  color: var(--color-text-tertiary);
  margin-bottom: var(--space-8);
  margin-top: calc(-1 * var(--space-3));
  max-width: 58ch;
}

.project-list {
  border-top: 1px solid var(--color-border);
}

.project-item {
  border-bottom: 1px solid var(--color-border);
  padding-block: var(--space-6);
  transition: background-color var(--transition-fast);
}

.project-row {
  display: grid;
  grid-template-columns: 1fr auto;
  gap: var(--space-8);
  align-items: start;
}

.project-name {
  font-size: var(--text-xl);
  font-weight: var(--font-bold);
  letter-spacing: -0.025em;
  margin-bottom: var(--space-2);
}

.project-desc {
  font-size: var(--text-sm);
  color: var(--color-text-secondary);
  max-width: 56ch;
  margin-bottom: var(--space-2);
}

.project-coming {
  font-size: var(--text-xs);
  font-family: var(--font-mono);
  color: var(--color-text-tertiary);
  max-width: none;
}

.project-stack {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2);
  justify-content: flex-end;
  flex-shrink: 0;
  padding-top: 0.2rem;
}

/* ── Contact ──────────────────────────────────────────────────────────── */

.contact-section {
  border-top: 1px solid var(--color-border);
}

.contact-inner {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-16);
  align-items: start;
}

.contact-body {
  font-size: var(--text-lg);
  color: var(--color-text-secondary);
  margin-top: var(--space-4);
  line-height: var(--leading-relaxed);
}

.contact-links {
  display: flex;
  flex-direction: column;
  gap: var(--space-4);
  padding-top: var(--space-2);
}

.contact-link {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  text-decoration: none;
  color: var(--color-text-secondary);
  transition: color var(--transition-fast);
  padding: var(--space-3);
  margin: calc(-1 * var(--space-3));
  border-radius: var(--radius-lg);
}

.contact-link:hover {
  color: var(--color-accent);
  background: var(--color-accent-muted);
}

.contact-link-icon {
  width: 36px;
  height: 36px;
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  color: inherit;
  transition: border-color var(--transition-fast), background-color var(--transition-fast);
}

.contact-link:hover .contact-link-icon {
  border-color: var(--color-accent-border);
  background: var(--color-accent-muted);
}

.contact-link-text {
  font-size: var(--text-sm);
  font-weight: var(--font-medium);
  font-family: var(--font-mono);
}

/* ── Avatar widget ────────────────────────────────────────────────────── */

.avatar-fixed {
  position: fixed;
  bottom: 1.5rem;
  right: 1.5rem;
  z-index: 40;
}

/* ── Responsive ──────────────────────────────────────────────────────── */

@media (max-width: 900px) {
  .current-inner {
    grid-template-columns: 100px 1fr;
    grid-template-rows: auto auto;
  }
  .current-cta {
    grid-column: 2;
    grid-row: 2;
    align-self: start;
  }
}

@media (max-width: 768px) {
  .hero-inner {
    grid-template-columns: 1fr;
    min-height: auto;
    gap: var(--space-10);
  }

  .hero-photo-wrap {
    order: -1;
    width: 180px;
    height: 210px;
    margin-inline: auto;
  }

  .hero-display {
    font-size: clamp(2.5rem, 10vw, 4rem);
  }

  .contact-inner {
    grid-template-columns: 1fr;
    gap: var(--space-8);
  }

  .project-row {
    grid-template-columns: 1fr;
  }

  .project-stack {
    justify-content: flex-start;
  }
}

@media (max-width: 640px) {
  .current-inner {
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }
  .current-label-col {
    flex-direction: row;
    align-items: center;
    gap: var(--space-3);
  }
  .current-cta {
    grid-column: 1;
    grid-row: auto;
  }

  .skill-row {
    grid-template-columns: 1fr;
    gap: var(--space-1);
  }

  .hero-actions {
    flex-direction: column;
    align-items: stretch;
  }
  .hero-actions .btn {
    justify-content: center;
  }

  .avatar-fixed {
    bottom: 1rem;
    right: 1rem;
  }
}
</style>
