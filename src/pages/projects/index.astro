---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { WORKFLOWDESK_DEMO_URL, WORKFLOWDESK_SOURCE_URL, DATABRIDGE_DEMO_URL, DATABRIDGE_SOURCE_URL } from '../../content/profile.ts';

const projects = [
  {
    id: 'workflowdesk',
    name: 'WorkflowDesk',
    status: 'demo' as const,
    demoUrl: WORKFLOWDESK_DEMO_URL,
    sourceUrl: WORKFLOWDESK_SOURCE_URL,
    stack: ['PHP', 'Laravel', 'Vue', 'TypeScript', 'MySQL'],
    description:
      'A multi-tenant enquiry queue for admissions and support teams: a Laravel 13 API with a Vue 3 and TypeScript front end. It is built around what enterprise teams ask about: tenant isolation, concurrent edits, an auditable history and SLA deadlines.',
    highlights: [
      'Two synthetic organisations with admin, counsellor and viewer roles. Every query is scoped to the caller\u2019s organisation, so another organisation\u2019s record returns 404',
      'Optimistic locking over HTTP: each change needs an If-Match header, and a stale write gets a 412 and overwrites nothing',
      'Tamper-evident audit log: each entry hashes the one before it, is written in the same transaction as the change, and a database trigger blocks edits and deletes. An endpoint verifies the chain',
      'SLA engine: deadlines follow each organisation\u2019s business hours and time zone, including daylight-saving changes, and a scheduled command flags enquiries that are at risk or breached',
      '66 backend tests run against a real MySQL 8.4 in CI, and architecture decision records explain the non-obvious choices',
      'The front end talks to the API through a typed adapter with live, browser-demo and unavailable modes',
    ],
    demoNote:
      'The hosted demo runs entirely in your browser on built-in sample data and makes no server calls. The Laravel API, its tests and its decision records are in the repository, and run locally with the steps in its README. Pick any demo account on the sign-in page, then press Sign in.',
  },
  {
    id: 'databridge',
    name: 'DataBridge Inspector',
    status: 'demo' as const,
    demoUrl: DATABRIDGE_DEMO_URL,
    sourceUrl: DATABRIDGE_SOURCE_URL,
    stack: ['Python', 'FastAPI', 'React', 'TypeScript'],
    description:
      'Contact data normalisation tool that maps CSV columns, validates required fields, detects and explains duplicates, and exports a cleaned file. Input limits enforced; original values always preserved alongside proposed changes.',
    highlights: [
      'Explainable duplicate detection with reasons',
      'Field-level normalisation preview before export',
      'Safe CSV export with formula injection protection',
      'File-size and row-count limits enforced',
    ],
    demoNote:
      'The hosted demo runs in your browser on synthetic sample data. The FastAPI backend and its source are in the repository and run locally with the steps in its README.',
  },
  {
    id: 'timeslot',
    name: 'TimeSlot',
    status: 'in-development' as const,
    demoUrl: null,
    sourceUrl: null,
    demoNote: null,
    stack: ['C#', 'ASP.NET Core', 'React', 'TypeScript', 'PostgreSQL'],
    description:
      'Timezone-aware appointment booking that stores UTC instants with IANA zone identifiers, prevents overlapping bookings via database constraints, and implements idempotent booking and atomic rescheduling.',
    highlights: [
      'UTC storage with IANA zone identity displayed to user',
      'Database-level concurrency protection for bookings',
      'Idempotent booking keys for safe retries',
      'Atomic rescheduling: old slot closed, new slot opened in one transaction',
    ],
  },
];
---

<BaseLayout
  title="Projects"
  description="Engineering projects across PHP/Laravel, Python/FastAPI, and C#/ASP.NET Core. WorkflowDesk and DataBridge Inspector have hosted demos and public source."
>
  <section class="section" aria-labelledby="projects-heading">
    <div class="container">

      <div class="projects-intro-block">
        <h1 id="projects-heading" class="projects-h1 page-anim-1">Projects</h1>
        <p class="projects-intro page-anim-2">
          Three focused projects across PHP/Laravel, Python/FastAPI, and C#/ASP.NET Core. WorkflowDesk and DataBridge Inspector have hosted demos and public source code; TimeSlot is still in development.
        </p>
      </div>

      <div class="project-list" role="list">
        {projects.map((project, i) => (
          <article
            id={project.id}
            class="project-item reveal"
            style={`transition-delay: ${i * 120}ms`}
            role="listitem"
            aria-labelledby={`project-${project.id}-title`}
          >
            <div class="project-top">
              <div class="project-header">
                <h2 id={`project-${project.id}-title`} class="project-name">
                  {project.name}
                </h2>
                {project.status === 'demo'
                  ? <span class="project-status project-status--live">Hosted demo</span>
                  : <span class="project-status">In development</span>}
              </div>
              <div class="project-stack">
                {project.stack.map(s => <span class="badge">{s}</span>)}
              </div>
            </div>

            <p class="project-desc">{project.description}</p>

            <ul class="project-highlights">
              {project.highlights.map(h => <li>{h}</li>)}
            </ul>

            {project.demoUrl ? (
              <div class="project-demo">
                <div class="project-demo-actions">
                  <a href={project.demoUrl} class="btn btn-primary" target="_blank" rel="noopener noreferrer">
                    Open the hosted demo
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7"/><path d="M7 7h10v10"/></svg>
                    <span class="visually-hidden">(opens in a new tab)</span>
                  </a>
                  {project.sourceUrl && (
                    <a href={project.sourceUrl} class="btn btn-outline" target="_blank" rel="noopener noreferrer">
                      View source on GitHub
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7"/><path d="M7 7h10v10"/></svg>
                      <span class="visually-hidden">(opens in a new tab)</span>
                    </a>
                  )}
                </div>
                <p class="project-demo-note">{project.demoNote}</p>
              </div>
            ) : (
              <p class="project-coming">Case study and browser demo coming soon.</p>
            )}
          </article>
        ))}
      </div>

      <div class="projects-footer-note">
        Projects are built independently. No source link is shown for a project until its repository is public.
      </div>

    </div>
  </section>
</BaseLayout>

<style>
/* ── Page entrance animations ─────────────────────────────────────────── */

@media (prefers-reduced-motion: no-preference) {
  .page-anim-1 { animation: enter-up 0.65s cubic-bezier(0.16, 1, 0.3, 1) both; animation-delay: 0.05s; }
  .page-anim-2 { animation: enter-up 0.65s cubic-bezier(0.16, 1, 0.3, 1) both; animation-delay: 0.18s; }
}

.projects-intro-block {
  max-width: 60ch;
  margin-bottom: var(--space-12);
}

.projects-h1 {
  font-size: clamp(var(--text-3xl), 5vw, var(--text-4xl));
  margin-bottom: var(--space-4);
  letter-spacing: -0.035em;
}

.projects-intro {
  font-size: var(--text-lg);
  color: var(--color-text-secondary);
  line-height: var(--leading-relaxed);
  max-width: 60ch;
}

/* Project list */
.project-list {
  border-top: 1px solid var(--color-border);
}

.project-item {
  scroll-margin-top: calc(var(--nav-height) + var(--space-4));
  padding-block: var(--space-10);
  border-bottom: 1px solid var(--color-border);
  display: grid;
  gap: var(--space-4);
}

.project-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: var(--space-6);
  flex-wrap: wrap;
}

.project-header {
  display: flex;
  align-items: center;
  gap: var(--space-4);
  flex-wrap: wrap;
}

.project-name {
  font-size: clamp(var(--text-2xl), 3vw, var(--text-3xl));
  font-weight: var(--font-bold);
  letter-spacing: -0.03em;
}

.project-status {
  font-family: var(--font-mono);
  font-size: var(--text-xs);
  padding: 0.25em 0.75em;
  border-radius: var(--radius-full);
  background: color-mix(in srgb, #f59e0b 12%, transparent);
  color: #b45309;
  border: 1px solid color-mix(in srgb, #f59e0b 25%, transparent);
  white-space: nowrap;
}

:global([data-theme="dark"]) .project-status {
  color: #fbbf24;
  background: rgba(251, 191, 36, 0.1);
  border-color: rgba(251, 191, 36, 0.2);
}

@media (prefers-color-scheme: dark) {
  :global(:root:not([data-theme="light"])) .project-status {
    color: #fbbf24;
    background: rgba(251, 191, 36, 0.1);
    border-color: rgba(251, 191, 36, 0.2);
  }
}

.project-status--live {
  background: color-mix(in srgb, #059669 12%, transparent);
  color: #047857;
  border-color: color-mix(in srgb, #059669 28%, transparent);
}

:global([data-theme="dark"]) .project-status--live {
  color: #34d399;
  background: rgba(52, 211, 153, 0.1);
  border-color: rgba(52, 211, 153, 0.22);
}

@media (prefers-color-scheme: dark) {
  :global(:root:not([data-theme="light"])) .project-status--live {
    color: #34d399;
    background: rgba(52, 211, 153, 0.1);
    border-color: rgba(52, 211, 153, 0.22);
  }
}

.project-demo {
  display: grid;
  gap: var(--space-3);
  justify-items: start;
  margin-top: var(--space-2);
}

.project-demo-actions {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-3);
}

.project-demo-note {
  font-size: var(--text-sm);
  color: var(--color-text-secondary);
  max-width: 62ch;
}

.project-stack {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2);
  align-self: flex-start;
}

.project-desc {
  font-size: var(--text-base);
  color: var(--color-text-secondary);
  line-height: var(--leading-relaxed);
  max-width: 68ch;
}

.project-highlights {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
  padding-left: var(--space-5);
  margin-top: var(--space-1);
}

.project-highlights li {
  font-size: var(--text-sm);
  color: var(--color-text-secondary);
  line-height: var(--leading-relaxed);
}

.project-coming {
  font-family: var(--font-mono);
  font-size: var(--text-xs);
  color: var(--color-text-tertiary);
  max-width: none;
}

.projects-footer-note {
  margin-top: var(--space-10);
  padding: var(--space-5) var(--space-6);
  background: var(--color-bg-secondary);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-xl);
  font-size: var(--text-sm);
  color: var(--color-text-secondary);
  line-height: var(--leading-relaxed);
}

@media (max-width: 640px) {
  .project-top {
    flex-direction: column;
  }

  .project-item:first-of-type::before {
    display: none;
  }
}
</style>
