---
import BaseLayout from '../../layouts/BaseLayout.astro';

const projects = [
  {
    id: 'workflowdesk',
    name: 'WorkflowDesk',
    status: 'in-development' as const,
    stack: ['PHP', 'Laravel', 'Vue', 'TypeScript', 'MySQL'],
    description:
      'Multi-tenant enquiry management system with role-based access control, configurable state transitions, and a complete audit history. Backend-enforced tenant isolation using Laravel policies and transactional state changes.',
    highlights: [
      'Server-enforced tenant and role boundaries',
      'Transactional state changes with audit events',
      'Pagination and filter state preserved on navigation',
      'Stale-update conflict handling',
    ],
  },
  {
    id: 'databridge',
    name: 'DataBridge Inspector',
    status: 'in-development' as const,
    stack: ['Python', 'FastAPI', 'React', 'TypeScript'],
    description:
      'Contact data normalisation tool that maps CSV columns, validates required fields, detects and explains duplicates, and exports a cleaned file. Input limits enforced; original values always preserved alongside proposed changes.',
    highlights: [
      'Explainable duplicate detection with reasons',
      'Field-level normalisation preview before export',
      'Safe CSV export with formula injection protection',
      'File-size and row-count limits enforced',
    ],
  },
  {
    id: 'timeslot',
    name: 'TimeSlot',
    status: 'in-development' as const,
    stack: ['C#', 'ASP.NET Core', 'React', 'TypeScript', 'PostgreSQL'],
    description:
      'Timezone-aware appointment booking that stores UTC instants with IANA zone identifiers, prevents overlapping bookings via database constraints, and implements idempotent booking and atomic rescheduling.',
    highlights: [
      'UTC storage with IANA zone identity displayed to user',
      'Database-level concurrency protection for bookings',
      'Idempotent booking keys for safe retries',
      'Atomic rescheduling: old slot closed, new slot opened in one transaction',
    ],
  },
];
---

<BaseLayout
  title="Projects"
  description="Backend engineering projects across PHP/Laravel, Python/FastAPI, and C#/ASP.NET Core - with real architecture, tests, and browser demos."
>
  <section class="section" aria-labelledby="projects-heading">
    <div class="container">

      <div class="projects-intro-block">
        <h1 id="projects-heading" class="projects-h1">Projects</h1>
        <p class="projects-intro">
          Three focused backend engineering case studies across different languages and frameworks. Each demonstrates real domain logic, tests, and an interactive browser simulation. Source code and Docker Compose startup instructions included.
        </p>
      </div>

      <div class="project-list" role="list">
        {projects.map(project => (
          <article
            class="project-item"
            role="listitem"
            aria-labelledby={`project-${project.id}-title`}
          >
            <div class="project-top">
              <div class="project-header">
                <h2 id={`project-${project.id}-title`} class="project-name">
                  {project.name}
                </h2>
                <span class="project-status">In development</span>
              </div>
              <div class="project-stack">
                {project.stack.map(s => <span class="badge">{s}</span>)}
              </div>
            </div>

            <p class="project-desc">{project.description}</p>

            <ul class="project-highlights">
              {project.highlights.map(h => <li>{h}</li>)}
            </ul>

            <p class="project-coming">Case study and browser demo coming soon.</p>
          </article>
        ))}
      </div>

      <div class="projects-footer-note">
        Projects are built independently to demonstrate backend engineering across PHP/Laravel, Python/FastAPI, and C#/ASP.NET Core. Each will include architecture notes and test coverage.
      </div>

    </div>
  </section>
</BaseLayout>

<style>
.projects-intro-block {
  max-width: 60ch;
  margin-bottom: var(--space-12);
}

.projects-h1 {
  font-size: clamp(var(--text-3xl), 5vw, var(--text-4xl));
  margin-bottom: var(--space-4);
  letter-spacing: -0.035em;
}

.projects-intro {
  font-size: var(--text-lg);
  color: var(--color-text-secondary);
  line-height: var(--leading-relaxed);
  max-width: 60ch;
}

/* Project list */
.project-list {
  border-top: 1px solid var(--color-border);
}

.project-item {
  padding-block: var(--space-10);
  border-bottom: 1px solid var(--color-border);
  display: grid;
  gap: var(--space-4);
}

.project-item:first-of-type {
  position: relative;
}

.project-item:first-of-type::before {
  content: '';
  position: absolute;
  top: 0;
  left: -1px;
  bottom: 0;
  width: 3px;
  background: var(--gradient-accent);
  border-radius: 0 2px 2px 0;
}

.project-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: var(--space-6);
  flex-wrap: wrap;
}

.project-header {
  display: flex;
  align-items: center;
  gap: var(--space-4);
  flex-wrap: wrap;
}

.project-name {
  font-size: clamp(var(--text-2xl), 3vw, var(--text-3xl));
  font-weight: var(--font-bold);
  letter-spacing: -0.03em;
}

.project-status {
  font-family: var(--font-mono);
  font-size: var(--text-xs);
  padding: 0.25em 0.75em;
  border-radius: var(--radius-full);
  background: color-mix(in srgb, #f59e0b 12%, transparent);
  color: #b45309;
  border: 1px solid color-mix(in srgb, #f59e0b 25%, transparent);
  white-space: nowrap;
}

:global([data-theme="dark"]) .project-status {
  color: #fbbf24;
  background: rgba(251, 191, 36, 0.1);
  border-color: rgba(251, 191, 36, 0.2);
}

@media (prefers-color-scheme: dark) {
  :global(:root:not([data-theme="light"])) .project-status {
    color: #fbbf24;
    background: rgba(251, 191, 36, 0.1);
    border-color: rgba(251, 191, 36, 0.2);
  }
}

.project-stack {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2);
  align-self: flex-start;
}

.project-desc {
  font-size: var(--text-base);
  color: var(--color-text-secondary);
  line-height: var(--leading-relaxed);
  max-width: 68ch;
}

.project-highlights {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
  padding-left: var(--space-5);
  margin-top: var(--space-1);
}

.project-highlights li {
  font-size: var(--text-sm);
  color: var(--color-text-secondary);
  line-height: var(--leading-relaxed);
}

.project-coming {
  font-family: var(--font-mono);
  font-size: var(--text-xs);
  color: var(--color-text-tertiary);
  max-width: none;
}

.projects-footer-note {
  margin-top: var(--space-10);
  padding: var(--space-5) var(--space-6);
  background: var(--color-bg-secondary);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-xl);
  font-size: var(--text-sm);
  color: var(--color-text-secondary);
  line-height: var(--leading-relaxed);
}

@media (max-width: 640px) {
  .project-top {
    flex-direction: column;
  }

  .project-item:first-of-type::before {
    display: none;
  }
}
</style>
