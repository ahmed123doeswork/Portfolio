---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import type { IconName } from '../../components/icons.ts';
import { PROJECTS, STATUS_LABEL, LANGUAGES, languageSlug, type ProjectStatus } from '../../content/projects.ts';
import jobHuntDashboard from '../../assets/projects/jobhunt/dashboard.png';
import jobHuntAts from '../../assets/projects/jobhunt/ats-check.png';
import jobHuntMobile from '../../assets/projects/jobhunt/mobile-dashboard.png';

const STATUS_ICON: Record<ProjectStatus, IconName> = {
  demo: 'globe',
  local: 'laptop',
  team: 'users',
};

const counts = Object.fromEntries(
  LANGUAGES.map(l => [l, PROJECTS.filter(p => p.languages.includes(l)).length]),
);
---

<BaseLayout
  title="Projects"
  description="Engineering projects across C#/ASP.NET Core, Python, PHP/Laravel and TypeScript, including Job Hunt, an open-source ATS CV builder and job search. Each has a public source link."
>
  <section class="section projects-page" aria-labelledby="projects-heading">
    <div class="container">

      <header class="projects-intro-block">
        <span class="icon-tile page-anim-1"><Icon name="folder" size={20} /></span>
        <h1 id="projects-heading" class="projects-h1 page-anim-1">Projects</h1>
        <p class="projects-intro page-anim-2">
          Four projects I built and published, across C#, Python, PHP and TypeScript, plus a team project. Three have hosted demos that run in your browser; Job Hunt runs on your own computer.
        </p>
      </header>

      <div class="filters page-anim-3" data-filters hidden>
        <span class="filters-label" id="filter-label"><Icon name="filter" size={16} />Language</span>
        <div class="filter-chips" role="group" aria-labelledby="filter-label">
          <button type="button" class="chip" data-lang="" aria-pressed="true">
            All <span class="chip-count">{PROJECTS.length}</span>
          </button>
          {LANGUAGES.map(l => (
            <button type="button" class="chip" data-lang={languageSlug(l)} aria-pressed="false">
              {l} <span class="chip-count">{counts[l]}</span>
            </button>
          ))}
        </div>
        <p class="visually-hidden" role="status" data-filter-status></p>
      </div>

      <div class="project-list" data-project-list>
        {PROJECTS.map((project) => (
          <article
            id={project.id}
            class="project reveal"
            aria-labelledby={`project-${project.id}-title`}
            data-langs={project.languages.map(languageSlug).join(' ')}
          >
            <header class="project-top">
              <span class="project-icon"><Icon name={project.icon} size={24} /></span>
              <div class="project-heading">
                <div class="project-name-row">
                  <h2 id={`project-${project.id}-title`} class="project-name">{project.name}</h2>
                  {project.isNew && <span class="badge badge-accent"><Icon name="sparkles" size={13} />New</span>}
                </div>
                <p class="project-tagline">{project.tagline}</p>
              </div>
              <span class:list={['status', `status--${project.status === 'demo' ? 'live' : project.status}`]}>
                {project.status === 'demo'
                  ? <span class="status-dot" aria-hidden="true"></span>
                  : <Icon name={STATUS_ICON[project.status]} size={13} />}
                {STATUS_LABEL[project.status]}
              </span>
            </header>

            <div class="project-stack" aria-label="Technology">
              {project.stack.map(s => <span class="badge">{s}</span>)}
            </div>

            <p class="project-desc">{project.description}</p>

            {project.id === 'jobhunt' && (
              <div class="gallery" role="group" aria-label="Job Hunt screenshots">
                <figure class="gallery-item gallery-wide">
                  <Image src={jobHuntDashboard} alt="Dashboard: jobs ranked by match score with filters for work mode, roles and source, and the selected job's details and status." widths={[640, 960, 1440]} sizes="(max-width: 900px) 92vw, 760px" loading="lazy" />
                  <figcaption><Icon name="list-checks" size={14} />Ranked jobs with status tracking</figcaption>
                </figure>
                <figure class="gallery-item">
                  <Image src={jobHuntAts} alt="ATS check: a score of 100 out of 100 with a checklist of passed items beside a live preview of the generated CV." widths={[480, 720, 960]} sizes="(max-width: 900px) 92vw, 380px" loading="lazy" />
                  <figcaption><Icon name="file-text" size={14} />ATS check beside the live CV preview</figcaption>
                </figure>
                <figure class="gallery-item gallery-phone">
                  <Image src={jobHuntMobile} alt="Job Hunt dashboard on a phone." widths={[240, 360, 480]} sizes="(max-width: 900px) 45vw, 180px" loading="lazy" />
                  <figcaption><Icon name="monitor" size={14} />Phone layout</figcaption>
                </figure>
              </div>
            )}

            {project.highlights.length > 0 && (
              <ul class="project-highlights" role="list">
                {project.highlights.map(h => (
                  <li>
                    <span class="hl-icon"><Icon name="check" size={14} strokeWidth={2.4} /></span>
                    <span>{h}</span>
                  </li>
                ))}
              </ul>
            )}

            {project.limitations && (
              <p class="project-limits">
                <Icon name="triangle-alert" size={16} />
                <span><strong>Limitations.</strong> {project.limitations}</span>
              </p>
            )}

            <div class="project-demo">
              <div class="project-demo-actions">
                {project.demoUrl && (
                  <a href={project.demoUrl} class="btn btn-primary" target="_blank" rel="noopener noreferrer">
                    <Icon name="globe" size={16} />
                    Open the hosted demo
                    <Icon name="arrow-up-right" size={15} class="icon-arrow" />
                    <span class="visually-hidden">(opens in a new tab)</span>
                  </a>
                )}
                {project.sourceUrl && (
                  <a
                    href={project.sourceUrl}
                    class:list={['btn', project.demoUrl || project.status === 'team' ? 'btn-outline' : 'btn-primary']}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    <Icon name="github" size={16} />
                    {project.status === 'team' ? 'View team repository' : 'View source on GitHub'}
                    <Icon name="arrow-up-right" size={15} class="icon-arrow" />
                    <span class="visually-hidden">(opens in a new tab)</span>
                  </a>
                )}
                {!project.demoUrl && !project.sourceUrl && (
                  <p class="project-coming">Case study and browser demo coming soon.</p>
                )}
              </div>
              <p class="project-demo-note">
                <Icon name="info" size={16} />
                <span>{project.demoNote}</span>
              </p>
            </div>
          </article>
        ))}
      </div>

      <p class="filter-empty" data-filter-empty hidden>
        No projects use that language yet. <button type="button" class="link-btn" data-filter-reset>Show all projects</button>
      </p>

      <p class="projects-footer-note">
        <Icon name="shield-check" size={18} />
        <span>WorkflowDesk, DataBridge Inspector, TimeSlot and Job Hunt are built independently. Musicity is a collaborative team project, shown as a contribution rather than a solo build. No source link is shown for a project until its repository is public.</span>
      </p>

    </div>
  </section>
</BaseLayout>

<script>
  type VTDoc = Document & { startViewTransition?: (cb: () => void) => { finished: Promise<void> } };

  function initFilters() {
    const bar = document.querySelector<HTMLElement>('[data-filters]');
    const list = document.querySelector<HTMLElement>('[data-project-list]');
    if (!bar || !list || bar.dataset.ready) return;
    bar.dataset.ready = 'true';
    bar.hidden = false;

    const chips = Array.from(bar.querySelectorAll<HTMLButtonElement>('[data-lang]'));
    const items = Array.from(list.querySelectorAll<HTMLElement>('[data-langs]'));
    const status = bar.querySelector<HTMLElement>('[data-filter-status]')!;
    const empty = document.querySelector<HTMLElement>('[data-filter-empty]')!;
    const valid = new Set(chips.map(c => c.dataset.lang));

    const render = (lang: string) => {
      let shown = 0;
      for (const item of items) {
        const match = !lang || item.dataset.langs!.split(' ').includes(lang);
        item.hidden = !match;
        if (match) { shown++; item.classList.add('is-visible'); }
      }
      chips.forEach(c => c.setAttribute('aria-pressed', String(c.dataset.lang === lang)));
      empty.hidden = shown > 0;
      const name = chips.find(c => c.dataset.lang === lang)?.firstChild?.textContent?.trim();
      status.textContent = lang ? `Showing ${shown} ${shown === 1 ? 'project' : 'projects'} using ${name}.` : `Showing all ${shown} projects.`;
    };

    const apply = (lang: string, push: boolean) => {
      const url = new URL(location.href);
      lang ? url.searchParams.set('lang', lang) : url.searchParams.delete('lang');
      url.hash = '';
      if (push) history.replaceState(history.state, '', url);

      const doc = document as VTDoc;
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!doc.startViewTransition || reduce || !push) { render(lang); return; }

      // Name each card so the browser morphs positions instead of jumping
      items.forEach(el => { el.style.viewTransitionName = `project-${el.id}`; });
      doc.startViewTransition(() => render(lang)).finished.finally(() => {
        items.forEach(el => { el.style.viewTransitionName = ''; });
      });
    };

    chips.forEach(chip => chip.addEventListener('click', () => {
      const lang = chip.dataset.lang ?? '';
      if (chip.getAttribute('aria-pressed') === 'true' && lang) apply('', true);
      else apply(lang, true);
    }));

    document.querySelector('[data-filter-reset]')?.addEventListener('click', () => apply('', true));

    const initial = new URL(location.href).searchParams.get('lang') ?? '';
    apply(valid.has(initial) ? initial : '', false);
  }

  document.addEventListener('astro:page-load', initFilters);
</script>

<style>
@media (prefers-reduced-motion: no-preference) {
  .page-anim-1 { animation: enter-up 0.7s var(--ease-out) both 0.05s; }
  .page-anim-2 { animation: enter-up 0.7s var(--ease-out) both 0.15s; }
  .page-anim-3 { animation: enter-up 0.7s var(--ease-out) both 0.24s; }
}

.projects-page { padding-top: var(--space-16); }

.projects-intro-block {
  max-width: 62ch;
  margin-bottom: var(--space-8);
}

.projects-intro-block .icon-tile { margin-bottom: var(--space-5); }

.projects-h1 {
  font-size: clamp(var(--text-4xl), 6vw, 4rem);
  letter-spacing: -0.045em;
  line-height: 1;
  margin-bottom: var(--space-4);
}

.projects-intro {
  font-size: var(--text-lg);
  color: var(--color-text-secondary);
}

/* ── Filters ── */

.filters {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: var(--space-3) var(--space-4);
  margin-bottom: var(--space-10);
  position: sticky;
  top: calc(var(--nav-height) + var(--space-2));
  z-index: 10;
  padding: var(--space-2);
  margin-inline: calc(-1 * var(--space-2));
  border-radius: var(--radius-full);
  background: var(--material-bg);
  backdrop-filter: blur(20px) saturate(180%);
  -webkit-backdrop-filter: blur(20px) saturate(180%);
  width: fit-content;
  max-width: calc(100% + 2 * var(--space-2));
}

.filters[hidden] { display: none; }

.filters-label {
  display: inline-flex;
  align-items: center;
  gap: var(--space-2);
  font-size: var(--text-sm);
  font-weight: var(--font-semibold);
  color: var(--color-text-secondary);
  padding-left: var(--space-2);
}

.filter-chips {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2);
}

.chip {
  display: inline-flex;
  align-items: center;
  gap: var(--space-2);
  min-height: 2.5rem;
  padding: 0 var(--space-4);
  border-radius: var(--radius-full);
  border: 1px solid var(--color-border);
  background: var(--color-surface);
  color: var(--color-text-secondary);
  font: inherit;
  font-size: var(--text-sm);
  font-weight: var(--font-medium);
  cursor: pointer;
  transition: background-color var(--transition-fast), color var(--transition-fast), border-color var(--transition-fast), transform var(--dur-base) var(--ease-out);
}

.chip:hover { color: var(--color-text-primary); border-color: var(--color-border-strong); }
.chip:active { transform: scale(0.95); transition-duration: var(--dur-press); }

.chip[aria-pressed="true"] {
  background: var(--color-text-primary);
  border-color: var(--color-text-primary);
  color: var(--color-bg);
}

.chip-count {
  font-size: var(--text-xs);
  min-width: 1.25rem;
  height: 1.25rem;
  padding: 0 0.35rem;
  display: inline-grid;
  place-items: center;
  border-radius: var(--radius-full);
  background: var(--color-bg-secondary);
  color: var(--color-text-secondary);
}

.chip[aria-pressed="true"] .chip-count {
  background: color-mix(in srgb, var(--color-bg) 22%, transparent);
  color: var(--color-bg);
}

/* ── Project cards ── */

.project-list {
  display: grid;
  gap: var(--space-6);
}

.project {
  scroll-margin-top: calc(var(--nav-height) + var(--space-16));
  padding: var(--space-8);
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-2xl);
  display: grid;
  gap: var(--space-5);
  transition: border-color var(--transition-base), box-shadow var(--transition-base);
}

.project[hidden] { display: none; }

.project:target {
  border-color: var(--color-accent-border);
  box-shadow: 0 0 0 4px var(--color-accent-muted);
}

.project-top {
  display: grid;
  grid-template-columns: auto minmax(0, 1fr) auto;
  align-items: center;
  gap: var(--space-4);
}

.project-icon {
  display: grid;
  place-items: center;
  width: 3.25rem;
  height: 3.25rem;
  border-radius: var(--radius-lg);
  background: var(--color-accent-muted);
  color: var(--color-accent);
  transition: transform var(--dur-slow) var(--ease-out);
}

.project:hover .project-icon { transform: rotate(-6deg) scale(1.04); }

.project-name-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: var(--space-3);
}

.project-name {
  font-size: clamp(var(--text-2xl), 3vw, var(--text-3xl));
  letter-spacing: -0.035em;
}

.project-tagline {
  font-size: var(--text-sm);
  color: var(--color-text-tertiary);
  margin-top: 0.15rem;
}

.project-stack {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2);
}

.project-desc {
  font-size: var(--text-base);
  color: var(--color-text-secondary);
  max-width: 72ch;
}

/* Gallery */
.gallery {
  display: grid;
  grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
  grid-template-rows: auto auto;
  gap: var(--space-4);
}

.gallery-wide { grid-column: 1; grid-row: 1 / span 2; }
.gallery-phone { grid-column: 2; grid-row: 2; max-width: 11rem; }

.gallery-item {
  margin: 0;
  display: grid;
  gap: var(--space-2);
  align-content: start;
}

.gallery-item :global(img) {
  width: 100%;
  height: auto;
  border-radius: var(--radius-lg);
  border: 1px solid var(--color-border);
  box-shadow: var(--shadow-md);
  transition: transform var(--dur-slow) var(--ease-out), box-shadow var(--dur-slow) var(--ease-out);
}

@media (hover: hover) {
  .gallery-item:hover :global(img) { transform: translateY(-3px); box-shadow: var(--shadow-lg); }
}

.gallery-item figcaption {
  display: inline-flex;
  align-items: center;
  gap: var(--space-2);
  font-size: var(--text-xs);
  color: var(--color-text-tertiary);
}

/* Highlights */
.project-highlights {
  list-style: none;
  padding: 0;
  display: grid;
  gap: var(--space-3);
  max-width: 78ch;
}

.project-highlights li {
  display: grid;
  grid-template-columns: auto 1fr;
  gap: var(--space-3);
  font-size: var(--text-sm);
  color: var(--color-text-secondary);
}

.hl-icon {
  display: grid;
  place-items: center;
  width: 1.375rem;
  height: 1.375rem;
  margin-top: 0.05rem;
  border-radius: 50%;
  background: var(--color-success-muted);
  color: var(--color-success);
}

.project-limits,
.project-demo-note {
  display: grid;
  grid-template-columns: auto 1fr;
  gap: var(--space-3);
  font-size: var(--text-sm);
  max-width: 78ch;
}

.project-limits {
  padding: var(--space-4);
  border-radius: var(--radius-lg);
  background: var(--color-warn-muted);
  border: 1px solid var(--color-warn-border);
  color: var(--color-text-secondary);
}

.project-limits :global(svg) { color: var(--color-warn); margin-top: 0.15rem; }

.project-demo {
  display: grid;
  gap: var(--space-4);
  padding-top: var(--space-5);
  border-top: 1px solid var(--color-border);
}

.project-demo-actions {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-3);
}

.project-demo-note { color: var(--color-text-secondary); }
.project-demo-note :global(svg) { color: var(--color-text-tertiary); margin-top: 0.15rem; }

.project-coming {
  font-size: var(--text-sm);
  color: var(--color-text-tertiary);
}

.filter-empty {
  padding: var(--space-10);
  text-align: center;
  color: var(--color-text-secondary);
  max-width: none;
}

.link-btn {
  background: none;
  border: none;
  font: inherit;
  color: var(--color-accent);
  text-decoration: underline;
  cursor: pointer;
}

.projects-footer-note {
  margin-top: var(--space-10);
  display: grid;
  grid-template-columns: auto 1fr;
  gap: var(--space-3);
  padding: var(--space-5) var(--space-6);
  background: var(--color-bg-secondary);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-xl);
  font-size: var(--text-sm);
  color: var(--color-text-secondary);
  max-width: none;
}

.projects-footer-note :global(svg) { color: var(--color-success); margin-top: 0.1rem; }

@media (max-width: 900px) {
  .gallery { grid-template-columns: 1fr 1fr; }
  .gallery-wide { grid-column: 1 / -1; grid-row: auto; }
  .gallery-phone { grid-column: auto; grid-row: auto; max-width: none; }
}

@media (max-width: 640px) {
  .projects-page { padding-top: var(--space-10); }
  .project { padding: var(--space-5); border-radius: var(--radius-xl); }
  .project-top { grid-template-columns: auto minmax(0, 1fr); }
  .project-top .status { grid-column: 1 / -1; justify-self: start; }
  .project-icon { width: 2.75rem; height: 2.75rem; }
  .filters { border-radius: var(--radius-xl); position: static; }
  .gallery { grid-template-columns: 1fr; }
  .gallery-phone { max-width: 14rem; }
  .project-demo-actions .btn { white-space: normal; text-align: center; min-height: 2.75rem; padding-block: var(--space-2); }
}
</style>
