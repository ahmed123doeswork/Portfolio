---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import '../styles/avatar.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
  noIndex?: boolean;
}

const {
  title,
  description = 'Ahmed — Full-stack software engineer working in ASP.NET Core, React and TypeScript.',
  image = '/assets/profile.png',
  noIndex = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? 'http://localhost:4321');
const pageTitle = title === 'Home' ? 'Ahmed — Software Engineer' : `${title} — Ahmed`;
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  {noIndex && <meta name="robots" content="noindex,nofollow" />}

  <title>{pageTitle}</title>

  <!-- Canonical -->
  <link rel="canonical" href={canonicalURL} />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={new URL(image, canonicalURL)} />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={new URL(image, canonicalURL)} />

  <!-- Favicon — profile photo -->
  <link rel="icon" type="image/png" href="/assets/profile.png" />
  <link rel="apple-touch-icon" href="/assets/profile.png" />

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=Instrument+Sans:wght@400..700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />

  <meta name="theme-color" content="#f5f6f8" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#0c0e12" media="(prefers-color-scheme: dark)" />

  <!-- Page transitions -->
  <ClientRouter />

  <!-- Theme initialization — inline to prevent flash. Re-applied after each
       client-side navigation, because the swapped-in <html> has no data-theme. -->
  <script is:inline>
    (function () {
      function apply(doc) {
        var theme;
        try {
          var stored = localStorage.getItem('theme');
          var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          theme = stored === 'light' || stored === 'dark' ? stored : (prefersDark ? 'dark' : 'light');
        } catch (e) { theme = 'light'; }
        doc.documentElement.setAttribute('data-theme', theme);
        doc.documentElement.classList.add('js');
      }
      apply(document);
      document.addEventListener('astro:before-swap', function (e) { apply(e.newDocument); });
    })();
  </script>
</head>
<body>
  <a href="#main-content" class="skip-link">Skip to main content</a>
  <Nav />
  <main id="main-content">
    <slot />
  </main>
  <Footer />

  <!-- Scroll-reveal: fade-up elements with .reveal class -->
  <script>
    let observer: IntersectionObserver | undefined;

    function observeReveals() {
      observer?.disconnect();
      const items = document.querySelectorAll<HTMLElement>('.reveal:not(.is-visible)');
      if (!('IntersectionObserver' in window) || window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        items.forEach(el => el.classList.add('is-visible'));
        return;
      }
      observer = new IntersectionObserver((entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            e.target.classList.add('is-visible');
            observer?.unobserve(e.target);
          }
        }
      }, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });
      items.forEach(el => observer!.observe(el));
    }

    document.addEventListener('astro:page-load', observeReveals);
  </script>
</body>
</html>

<style is:global>
.skip-link {
  position: absolute;
  top: -100%;
  left: var(--space-4);
  background: var(--color-accent);
  color: var(--color-text-on-accent);
  padding: var(--space-2) var(--space-4);
  border-radius: var(--radius-md);
  font-weight: var(--font-semibold);
  text-decoration: none;
  z-index: 9999;
  transition: top var(--transition-fast);
}

.skip-link:focus {
  top: var(--space-4);
}
</style>
