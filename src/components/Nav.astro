---
import ThemeToggle from './ThemeToggle.tsx';
import Icon from './Icon.astro';
import type { IconName } from './icons.ts';
import { PROFILE } from '../content/profile.ts';

const navLinks: { href: string; label: string; icon: IconName }[] = [
  { href: '/', label: 'Home', icon: 'home' },
  { href: '/projects', label: 'Projects', icon: 'folder' },
  { href: '/about', label: 'About', icon: 'user' },
];

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => (href === '/' ? currentPath === '/' : currentPath.startsWith(href));
---

<header class="nav-header" id="site-header">
  <nav class="nav-inner container" aria-label="Main navigation">
    <a href="/" class="nav-logo" aria-label="Ahmed, home">
      <span class="nav-logo-name">Ahmed</span>
    </a>

    <ul class="nav-links" role="list">
      {navLinks.map(({ href, label }) => (
        <li>
          <a
            href={href}
            class:list={['nav-link', { 'is-active': isActive(href) }]}
            aria-current={isActive(href) ? 'page' : undefined}
          >
            {label}
          </a>
        </li>
      ))}
    </ul>

    <div class="nav-end">
      {PROFILE.resumePath && (
        <a
          href={PROFILE.resumePath}
          class="btn btn-ghost btn-icon nav-resume"
          download
          aria-label="Download résumé (PDF)"
          title="Download résumé"
        >
          <Icon name="download" size={18} />
        </a>
      )}
      <ThemeToggle client:load />
      <a href="/#contact" class="btn btn-primary btn-sm nav-cta">
        <Icon name="send" size={15} />
        Contact
      </a>
      <button
        class="nav-burger"
        id="mobile-menu-toggle"
        type="button"
        aria-label="Open navigation menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="burger-line" aria-hidden="true"></span>
        <span class="burger-line" aria-hidden="true"></span>
      </button>
    </div>
  </nav>

  <div class="mobile-menu" id="mobile-menu" data-open="false">
    <ul class="mobile-links" role="list">
      {navLinks.map(({ href, label, icon }, i) => (
        <li style={`--i:${i}`}>
          <a
            href={href}
            class:list={['mobile-link', { 'is-active': isActive(href) }]}
            aria-current={isActive(href) ? 'page' : undefined}
          >
            <span class="mobile-link-icon"><Icon name={icon} size={18} /></span>
            {label}
          </a>
        </li>
      ))}
      <li style={`--i:${navLinks.length}`}>
        <a href="/#contact" class="mobile-link">
          <span class="mobile-link-icon"><Icon name="send" size={18} /></span>
          Contact
        </a>
      </li>
      {PROFILE.resumePath && (
        <li style={`--i:${navLinks.length + 1}`}>
          <a href={PROFILE.resumePath} class="mobile-link" download>
            <span class="mobile-link-icon"><Icon name="download" size={18} /></span>
            Download résumé
          </a>
        </li>
      )}
    </ul>
  </div>
</header>

<script>
  function initNav() {
    const header = document.getElementById('site-header');
    const toggle = document.getElementById('mobile-menu-toggle');
    const menu = document.getElementById('mobile-menu');
    if (!header || !toggle || !menu) return;

    const setOpen = (open: boolean, returnFocus = false) => {
      menu.dataset.open = String(open);
      header.classList.toggle('menu-open', open);
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Close navigation menu' : 'Open navigation menu');
      if (open) menu.querySelector<HTMLElement>('a')?.focus({ preventScroll: true });
      else if (returnFocus) toggle.focus();
    };

    toggle.addEventListener('click', () => setOpen(menu.dataset.open !== 'true'));
    menu.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) setOpen(false);
    });

    const onKey = (e: KeyboardEvent) => {
      if (e.key === 'Escape' && menu.dataset.open === 'true') setOpen(false, true);
    };
    const onScroll = () => header.classList.toggle('is-scrolled', window.scrollY > 4);
    const onResize = () => { if (window.innerWidth >= 720 && menu.dataset.open === 'true') setOpen(false); };

    document.addEventListener('keydown', onKey);
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onResize, { passive: true });
    onScroll();

    document.addEventListener('astro:before-swap', () => {
      document.removeEventListener('keydown', onKey);
      window.removeEventListener('scroll', onScroll);
      window.removeEventListener('resize', onResize);
    }, { once: true });
  }

  document.addEventListener('astro:page-load', initNav);
</script>

<style>
.nav-header {
  position: sticky;
  top: 0;
  z-index: 50;
  background: var(--material-bg);
  backdrop-filter: blur(20px) saturate(180%);
  -webkit-backdrop-filter: blur(20px) saturate(180%);
  border-bottom: 1px solid transparent;
  transition: box-shadow var(--transition-base), border-color var(--transition-base);
}

/* Scroll edge effect: separation appears only once content runs underneath */
.nav-header.is-scrolled,
.nav-header.menu-open {
  border-bottom-color: var(--color-border-subtle);
  box-shadow: var(--material-shadow);
}

.nav-inner {
  display: flex;
  align-items: center;
  height: var(--nav-height);
  gap: var(--space-6);
}

/* Logo */
.nav-logo {
  display: inline-flex;
  align-items: center;
  gap: var(--space-2);
  text-decoration: none;
  flex-shrink: 0;
  margin-right: auto;
  border-radius: var(--radius-full);
  padding: 0.3rem 0.7rem;
  margin-left: -0.7rem;
  transition: background-color var(--transition-fast), transform var(--dur-base) var(--ease-out);
}

.nav-logo:hover { background: var(--color-bg-secondary); }
.nav-logo:active { transform: scale(0.97); transition-duration: var(--dur-press); }

.nav-logo-img {
  width: 28px;
  height: 28px;
  border-radius: 50%;
  object-fit: cover;
  object-position: center top;
  box-shadow: 0 0 0 1px var(--color-border);
}

.nav-logo-name {
  font-family: var(--font-display);
  font-weight: var(--font-bold);
  font-size: var(--text-base);
  color: var(--color-text-primary);
  letter-spacing: -0.02em;
}

/* Links: active state is a filled pill, hover a lighter one */
.nav-links {
  display: flex;
  align-items: center;
  gap: var(--space-1);
  list-style: none;
  padding: 0.25rem;
  margin: 0;
  border-radius: var(--radius-full);
  background: color-mix(in srgb, var(--color-bg-secondary) 70%, transparent);
  border: 1px solid var(--color-border-subtle);
}

.nav-link {
  display: block;
  padding: 0.45rem 0.95rem;
  font-size: var(--text-sm);
  font-weight: var(--font-medium);
  color: var(--color-text-secondary);
  text-decoration: none;
  border-radius: var(--radius-full);
  transition: color var(--transition-fast), background-color var(--transition-fast), box-shadow var(--transition-fast), transform var(--dur-base) var(--ease-out);
}

.nav-link:hover {
  color: var(--color-text-primary);
  background: color-mix(in srgb, var(--color-surface) 60%, transparent);
}

.nav-link:active { transform: scale(0.96); transition-duration: var(--dur-press); }

.nav-link.is-active {
  color: var(--color-text-primary);
  font-weight: var(--font-semibold);
  background: var(--color-surface);
  box-shadow: var(--shadow-sm), 0 0 0 1px var(--color-border-subtle);
}

/* End controls */
.nav-end {
  display: flex;
  align-items: center;
  gap: var(--space-1);
  flex-shrink: 0;
}

.nav-cta { margin-left: var(--space-2); }

/* Burger morphs into an X */
.nav-burger {
  display: none;
  position: relative;
  width: 2.75rem;
  height: 2.75rem;
  background: none;
  border: none;
  border-radius: var(--radius-full);
  color: var(--color-text-primary);
  cursor: pointer;
  transition: background-color var(--transition-fast), transform var(--dur-base) var(--ease-out);
}

.nav-burger:hover { background: var(--color-bg-secondary); }
.nav-burger:active { transform: scale(0.92); transition-duration: var(--dur-press); }

.burger-line {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 18px;
  height: 2px;
  margin-left: -9px;
  border-radius: 2px;
  background: currentColor;
  transition: transform var(--dur-slow) var(--ease-out);
}

.burger-line:nth-child(1) { transform: translateY(-4px); }
.burger-line:nth-child(2) { transform: translateY(4px); }

.nav-header.menu-open .burger-line:nth-child(1) { transform: rotate(45deg); }
.nav-header.menu-open .burger-line:nth-child(2) { transform: rotate(-45deg); }

/* Mobile menu: grows from the burger (top-right), returns the same way */
.mobile-menu {
  position: absolute;
  top: calc(100% + var(--space-2));
  right: var(--gutter);
  width: min(18rem, calc(100vw - 2 * var(--gutter)));
  padding: var(--space-2);
  background: var(--color-surface-elevated);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow-xl);
  transform-origin: top right;
  opacity: 0;
  transform: scale(0.94) translateY(-6px);
  visibility: hidden;
  pointer-events: none;
  transition:
    opacity var(--dur-fast) var(--ease-out),
    transform var(--dur-base) var(--ease-out),
    visibility 0s linear var(--dur-base);
}

.mobile-menu[data-open="true"] {
  opacity: 1;
  transform: none;
  visibility: visible;
  pointer-events: auto;
  transition:
    opacity var(--dur-fast) var(--ease-out),
    transform var(--dur-slow) var(--ease-out),
    visibility 0s;
}

.mobile-links {
  display: grid;
  gap: 2px;
  list-style: none;
  padding: 0;
  margin: 0;
}

@media (prefers-reduced-motion: no-preference) {
  .mobile-menu[data-open="true"] .mobile-links li {
    animation: enter-up 0.36s var(--ease-out) both;
    animation-delay: calc(var(--i) * 35ms + 40ms);
  }
}

.mobile-link {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  min-height: 2.75rem;
  padding: 0 var(--space-3);
  font-size: var(--text-base);
  font-weight: var(--font-medium);
  color: var(--color-text-primary);
  text-decoration: none;
  border-radius: var(--radius-md);
  transition: background-color var(--transition-fast);
}

.mobile-link:hover { background-color: var(--color-bg-secondary); color: var(--color-text-primary); }
.mobile-link:active { background-color: var(--color-accent-muted); }

.mobile-link-icon {
  display: grid;
  place-items: center;
  color: var(--color-text-tertiary);
}

.mobile-link.is-active { color: var(--color-accent); font-weight: var(--font-semibold); }
.mobile-link.is-active .mobile-link-icon { color: var(--color-accent); }

@media (max-width: 719px) {
  .nav-links  { display: none; }
  .nav-burger { display: inline-block; }
  .nav-resume { display: none; }
  .nav-cta { margin-left: 0; padding-inline: var(--space-3); }
}

@media (max-width: 359px) {
  .nav-logo-name { display: none; }
}

@media (min-width: 720px) {
  .mobile-menu { display: none; }
}
</style>
