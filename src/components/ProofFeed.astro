---
// Hero feed: documented behaviours from each project, shown as input → outcome.
// Every line must describe something the linked repository actually does.
import Icon from './Icon.astro';
import type { IconName } from './icons.ts';

interface FeedEvent {
  project: string;
  href: string;
  icon: IconName;
  input: string;
  code: string;
  outcome: string;
}

const EVENTS: FeedEvent[] = [
  { project: 'WorkflowDesk', href: '/projects#workflowdesk', icon: 'inbox',
    input: 'PATCH enquiry   If-Match: "v6"', code: '412', outcome: 'Stale edit rejected. Nothing overwritten.' },
  { project: 'TimeSlot', href: '/projects#timeslot', icon: 'calendar-clock',
    input: 'Two clients book the same slot', code: '1 of 2', outcome: 'Database constraint stops the overlap.' },
  { project: 'Job Hunt', href: '/projects#jobhunt', icon: 'briefcase',
    input: '"Senior Engineer" on an entry-level search', code: 'skipped', outcome: 'Wrong level for this search.' },
  { project: 'DataBridge', href: '/projects#databridge', icon: 'sheet',
    input: 'Cell =HYPERLINK("…") in CSV', code: 'escaped', outcome: 'Formula cells neutralised on export.' },
  { project: 'WorkflowDesk', href: '/projects#workflowdesk', icon: 'inbox',
    input: 'GET enquiry from another organisation', code: '404', outcome: 'Other tenants’ records stay invisible.' },
  { project: 'TimeSlot', href: '/projects#timeslot', icon: 'calendar-clock',
    input: 'Retry with the same idempotency key', code: 'replayed', outcome: 'Same booking returned, no duplicate.' },
  { project: 'Job Hunt', href: '/projects#jobhunt', icon: 'briefcase',
    input: 'CV bullet with no action verb', code: 'ATS check', outcome: 'Flagged, with a Fix button.' },
  { project: 'WorkflowDesk', href: '/projects#workflowdesk', icon: 'inbox',
    input: 'UPDATE audit_log …', code: 'blocked', outcome: 'Trigger keeps the hash chain intact.' },
  { project: 'DataBridge', href: '/projects#databridge', icon: 'sheet',
    input: 'Two near-identical contacts', code: 'flagged', outcome: 'Possible duplicate, reason explained.' },
];

const VISIBLE = 4;
---

<section class="feed" aria-labelledby="feed-title" data-feed>
  <header class="feed-head">
    <span class="feed-title" id="feed-title">
      <span class="feed-live" aria-hidden="true"></span>
      What the code does
    </span>
    <button type="button" class="feed-toggle" data-feed-toggle hidden aria-pressed="false">
      <span class="feed-toggle-pause"><Icon name="pause" size={14} /></span>
      <span class="feed-toggle-play"><Icon name="play" size={14} /></span>
      <span class="visually-hidden" data-feed-toggle-label>Pause updates</span>
    </button>
  </header>

  <ol class="feed-list" data-feed-list>
    {EVENTS.slice(0, VISIBLE).map((e, i) => (
      <li class="feed-row" data-index={i}>
        <a href={e.href} class="feed-link">
          <span class="feed-icon"><Icon name={e.icon} size={16} /></span>
          <span class="feed-body">
            <span class="feed-project">{e.project}</span>
            <code class="feed-input">{e.input}</code>
            <span class="feed-outcome">
              <span class="feed-code"><Icon name="check" size={12} strokeWidth={2.6} />{e.code}</span>
              <span class="feed-outcome-text">{e.outcome}</span>
            </span>
          </span>
        </a>
      </li>
    ))}
  </ol>

  <template data-feed-pool>
    {EVENTS.map((e, i) => (
      <li class="feed-row" data-index={i}>
        <a href={e.href} class="feed-link">
          <span class="feed-icon"><Icon name={e.icon} size={16} /></span>
          <span class="feed-body">
            <span class="feed-project">{e.project}</span>
            <code class="feed-input">{e.input}</code>
            <span class="feed-outcome">
              <span class="feed-code"><Icon name="check" size={12} strokeWidth={2.6} />{e.code}</span>
              <span class="feed-outcome-text">{e.outcome}</span>
            </span>
          </span>
        </a>
      </li>
    ))}
  </template>

  <p class="feed-foot">Behaviour documented in each project’s repository. Select a line for details.</p>
</section>

<script>
  const INTERVAL = 3600;
  const RESOLVE_DELAY = 620;

  function initFeed() {
    const root = document.querySelector<HTMLElement>('[data-feed]');
    if (!root || root.dataset.ready) return;
    root.dataset.ready = 'true';

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    if (reduce.matches) return; // static list is the reduced-motion experience

    const list = root.querySelector<HTMLOListElement>('[data-feed-list]')!;
    const pool = root.querySelector<HTMLTemplateElement>('[data-feed-pool]')!;
    const toggle = root.querySelector<HTMLButtonElement>('[data-feed-toggle]')!;
    const toggleLabel = root.querySelector<HTMLElement>('[data-feed-toggle-label]')!;
    const templates = Array.from(pool.content.children) as HTMLLIElement[];
    const visible = list.children.length;

    let next = visible % templates.length;
    let timer: number | undefined;
    const holds = new Set<string>();

    const step = () => {
      const rows = Array.from(list.children) as HTMLElement[];
      const before = new Map(rows.map(r => [r, r.getBoundingClientRect().top]));

      // Outgoing row leaves the flow (so the card never changes height), then fades
      const last = rows.length >= visible ? rows[rows.length - 1] : undefined;
      if (last) {
        Object.assign(last.style, { position: 'absolute', top: `${last.offsetTop}px`, left: '0', right: '0' });
        requestAnimationFrame(() => last.classList.add('is-leaving'));
        window.setTimeout(() => last.remove(), 450);
      }

      const fresh = templates[next].cloneNode(true) as HTMLLIElement;
      next = (next + 1) % templates.length;
      fresh.classList.add('is-pending');
      list.prepend(fresh);

      // FLIP: remaining rows glide from their old position to the new one
      for (const row of rows) {
        if (row === last) continue;
        const delta = (before.get(row) ?? 0) - row.getBoundingClientRect().top;
        if (delta) {
          row.animate(
            [{ transform: `translateY(${delta}px)` }, { transform: 'none' }],
            { duration: 520, easing: 'cubic-bezier(0.22, 1, 0.36, 1)' },
          );
        }
      }

      window.setTimeout(() => fresh.classList.remove('is-pending'), RESOLVE_DELAY);
    };

    const schedule = () => {
      window.clearTimeout(timer);
      if (holds.size) return;
      timer = window.setTimeout(() => { step(); schedule(); }, INTERVAL);
    };

    const hold = (key: string, on: boolean) => {
      on ? holds.add(key) : holds.delete(key);
      root.classList.toggle('is-paused', holds.has('user'));
      schedule();
    };

    toggle.hidden = false;
    toggle.addEventListener('click', () => {
      const paused = !holds.has('user');
      hold('user', paused);
      toggle.setAttribute('aria-pressed', String(paused));
      toggleLabel.textContent = paused ? 'Resume updates' : 'Pause updates';
    });

    root.addEventListener('pointerenter', () => hold('hover', true));
    root.addEventListener('pointerleave', () => hold('hover', false));
    root.addEventListener('focusin', () => hold('focus', true));
    root.addEventListener('focusout', (e) => {
      if (!root.contains(e.relatedTarget as Node)) hold('focus', false);
    });

    const io = new IntersectionObserver(([entry]) => hold('offscreen', !entry.isIntersecting));
    io.observe(root);

    const onVisibility = () => hold('hidden', document.hidden);
    document.addEventListener('visibilitychange', onVisibility);

    const onReduce = () => { if (reduce.matches) hold('reduce', true); };
    reduce.addEventListener('change', onReduce);

    document.addEventListener('astro:before-swap', () => {
      window.clearTimeout(timer);
      io.disconnect();
      document.removeEventListener('visibilitychange', onVisibility);
      reduce.removeEventListener('change', onReduce);
    }, { once: true });

    schedule();
  }

  document.addEventListener('astro:page-load', initFeed);
</script>

<style>
.feed {
  position: relative;
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-2xl);
  box-shadow: var(--shadow-xl);
  padding: var(--space-5);
  isolation: isolate;
}

.feed-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-3);
  padding: 0 var(--space-1) var(--space-4);
}

.feed-title {
  display: inline-flex;
  align-items: center;
  gap: var(--space-2);
  font-size: var(--text-sm);
  font-weight: var(--font-semibold);
  color: var(--color-text-primary);
}

.feed-live {
  width: 0.5rem;
  height: 0.5rem;
  border-radius: 50%;
  background: var(--color-success);
  box-shadow: 0 0 0 3px var(--color-success-muted);
  transition: background-color var(--transition-base), box-shadow var(--transition-base);
}

.feed.is-paused .feed-live {
  background: var(--color-text-tertiary);
  box-shadow: 0 0 0 3px var(--color-bg-secondary);
}

@media (prefers-reduced-motion: no-preference) {
  .feed:not(.is-paused) .feed-live { animation: live-breathe 2.4s var(--ease-in-out) infinite; }
}

@keyframes live-breathe {
  0%, 100% { box-shadow: 0 0 0 3px var(--color-success-muted); }
  50%      { box-shadow: 0 0 0 6px transparent; }
}

.feed-toggle {
  display: inline-grid;
  place-items: center;
  width: 2rem;
  height: 2rem;
  border-radius: var(--radius-full);
  border: 1px solid var(--color-border);
  background: var(--color-bg);
  color: var(--color-text-secondary);
  cursor: pointer;
  transition: color var(--transition-fast), border-color var(--transition-fast), transform var(--dur-base) var(--ease-out);
}

.feed-toggle[hidden] { display: none; }
.feed-toggle:hover { color: var(--color-text-primary); border-color: var(--color-border-strong); }
.feed-toggle:active { transform: scale(0.92); transition-duration: var(--dur-press); }
.feed-toggle-play { display: none; }
.feed-toggle[aria-pressed="true"] .feed-toggle-pause { display: none; }
.feed-toggle[aria-pressed="true"] .feed-toggle-play { display: inline; }

.feed-list {
  position: relative;
  list-style: none;
  padding: 0;
  display: grid;
  gap: var(--space-2);
  min-height: 0;
}

.feed-row {
  transition: opacity 0.4s var(--ease-out), transform 0.4s var(--ease-out);
}

.feed-link {
  display: grid;
  grid-template-columns: auto 1fr;
  gap: var(--space-3);
  align-items: start;
  padding: var(--space-3);
  border-radius: var(--radius-lg);
  background: var(--color-bg);
  border: 1px solid var(--color-border-subtle);
  text-decoration: none;
  color: inherit;
  transition: border-color var(--transition-fast), background-color var(--transition-fast), transform var(--dur-base) var(--ease-out);
}

.feed-link:hover {
  border-color: var(--color-accent-border);
  background: var(--color-accent-muted);
}

.feed-link:active { transform: scale(0.985); transition-duration: var(--dur-press); }

.feed-icon {
  display: grid;
  place-items: center;
  width: 2rem;
  height: 2rem;
  border-radius: var(--radius-md);
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  color: var(--color-accent);
}

.feed-body {
  display: grid;
  gap: 0.2rem;
  min-width: 0;
}

.feed-project {
  font-size: var(--text-xs);
  font-weight: var(--font-semibold);
  color: var(--color-text-tertiary);
  letter-spacing: 0.01em;
}

.feed-input {
  font-family: var(--font-mono);
  font-size: 0.78rem;
  color: var(--color-text-primary);
  background: none;
  padding: 0;
  white-space: pre;
  overflow: hidden;
  text-overflow: ellipsis;
}

.feed-outcome {
  position: relative;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: var(--space-2);
  margin-top: 0.15rem;
}

.feed-code {
  display: inline-flex;
  align-items: center;
  gap: 0.25rem;
  font-family: var(--font-mono);
  font-size: 0.7rem;
  font-weight: var(--font-medium);
  padding: 0.1rem 0.45rem;
  border-radius: var(--radius-full);
  color: var(--color-success);
  background: var(--color-success-muted);
  border: 1px solid var(--color-success-border);
  transition: opacity 0.3s var(--ease-out), transform 0.35s var(--ease-out);
}

.feed-outcome-text {
  font-size: var(--text-xs);
  color: var(--color-text-secondary);
  transition: opacity 0.35s var(--ease-out) 80ms;
}

/* Entering row: arrives, then its outcome resolves (cause → effect) */
@media (prefers-reduced-motion: no-preference) {
  .feed-row.is-pending {
    animation: feed-enter 0.5s var(--ease-out) both;
  }
  .feed-row.is-pending .feed-code {
    opacity: 0;
    transform: scale(0.85);
  }
  .feed-row.is-pending .feed-outcome-text {
    opacity: 0;
  }
  .feed-row.is-pending .feed-outcome::before {
    content: '';
    width: 0.9rem;
    height: 0.9rem;
    border-radius: 50%;
    border: 2px solid var(--color-border-strong);
    border-top-color: var(--color-accent);
    animation: feed-spin 0.7s linear infinite;
    position: absolute;
    left: 0;
    top: 50%;
    margin-top: -0.45rem;
  }
}

.feed-row.is-leaving {
  opacity: 0;
  transform: translateY(8px) scale(0.97);
  pointer-events: none;
}

@keyframes feed-enter {
  from { opacity: 0; transform: translateY(-10px) scale(0.98); }
  to   { opacity: 1; transform: none; }
}

@keyframes feed-spin {
  to { transform: rotate(360deg); }
}

.feed-foot {
  font-size: var(--text-xs);
  color: var(--color-text-tertiary);
  padding: var(--space-4) var(--space-1) 0;
  max-width: none;
}

/* Keep height stable while rows swap so the hero never jumps */
.feed-list { grid-auto-rows: min-content; }

@media (max-width: 420px) {
  .feed { padding: var(--space-4); border-radius: var(--radius-xl); }
  .feed-input { white-space: normal; overflow-wrap: anywhere; }
}
</style>
